    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag billeder til strikkeprojekter, dagbogsnotater og garnetiketter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Kamera kannst du Fotos zu Strickprojekten, Tagebucheinträgen und Garnetiketten hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τραβήξτε φωτογραφίες για έργα πλεξίματος, καταχωρίσεις ημερολογίου και ετικέτες νημάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take photos for knitting projects, journal entries, and yarn labels."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota kuvia neuleprojekteja ja päiväkirjamerkintöjä varten sekä lankojen etiketeistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo permet d’ajouter des photos aux projets de tricot, aux entrées du journal et aux étiquettes de fil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編み物の作品、編み物日記、毛糸ラベルに写真を追加するためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뜨개질 프로젝트, 일기 항목 및 실 라벨에 사용할 사진을 촬영합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bilder til strikkeprosjekter, dagbokoppføringer og garnetiketter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak foto's voor breiprojecten, dagboekitems en garenlabels."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bilder till stickprojekt, dagboksanteckningar och garnetiketter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍摄照片并添加到编织作品、编织日记和毛线标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝照片加入你的編織作品、編織日記與毛線標籤。"
          }
        }
      }
    }
  },
  "version" : "1.0"
