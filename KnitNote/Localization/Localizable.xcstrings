    "calculator.adjustment.failure.requiresMultipleRows" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne justering kan ikke udføres ligeligt på én pind. Del den på tværs af flere pinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anpassung lässt sich nicht gleichmäßig in einer Reihe verteilen. Verteile sie auf mehrere Reihen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η προσαρμογή δεν μπορεί να ολοκληρωθεί ομοιόμορφα σε μία σειρά. Χωρίστε την σε πολλές σειρές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This adjustment cannot be completed evenly in one row. Divide it across multiple rows."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä muutosta ei voi tehdä tasaisesti yhdellä kerroksella. Jaa se usealle kerrokselle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet ajustement ne peut pas être réparti uniformément sur un seul rang. Répartissez-le sur plusieurs rangs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この調整は1段に均等に配置できません。複数の段に分けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 조정은 한 단에 균일하게 완료할 수 없습니다. 여러 단으로 나누어 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne justeringen kan ikke fullføres jevnt på én rad. Del den opp i flere rader."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna justering kan inte göras jämnt på ett varv. Fördela den över flera varv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次调整无法在一行内平均完成，请分成多行进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這次調整無法在一排內平均完成，請分成多排進行。"
          }
        }
      }
    },
