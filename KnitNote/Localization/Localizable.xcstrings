          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンク済みの作品が変更されました。作品とのリンクを確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나 이상의 연결된 프로젝트가 변경되었습니다. 프로젝트 링크를 검토한 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
