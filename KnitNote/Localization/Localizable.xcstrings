    "backup.error.exportFailed" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote kunne ikke oprette en sikkerhedskopi. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote konnte keine Sicherung erstellen. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnitNote δεν μπόρεσε να δημιουργήσει αντίγραφο ασφαλείας. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote couldn't create a backup. Please try again."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote ei voinut luoda varmuuskopiota. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote n’a pas pu créer de sauvegarde. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNoteはバックアップを作成できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote에서 백업을 생성할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote klarte ikke å lage en sikkerhetskopi. Vennligst prøv igjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
