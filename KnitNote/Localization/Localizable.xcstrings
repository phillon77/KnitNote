        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett eller flere tilknyttede prosjekter er endret. Se gjennom prosjektkoblingene og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een of meer gekoppelde projecten zijn gewijzigd. Controleer de projectkoppelingen en probeer het opnieuw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
