    "about.usage.body" : {
      "comment": "Approved KnitNote family origin story. Lemon's year is 2025. Keep user content separate.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bruger KnitNote, anbefaler jeg en iPad eller en computer med en større skærm, for eksempel en Mac. Opskrifter og instruktionsvideoer er lettere at se, visningen føles mere behagelig, og der er mindre risiko for at trykke forkert på tælleren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für KnitNote empfehle ich ein iPad oder einen Computer mit größerem Bildschirm, zum Beispiel einen Mac. Strickmuster und Lernvideos lassen sich darauf besser erkennen, das Betrachten ist angenehmer und man tippt seltener versehentlich auf die falsche Zählerfunktion."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για το KnitNote προτείνω ένα iPad ή έναν υπολογιστή με μεγαλύτερη οθόνη, όπως ένα Mac. Τα σχέδια και τα εκπαιδευτικά βίντεο φαίνονται πιο καθαρά, η προβολή είναι πιο άνετη και μειώνεται η πιθανότητα να πατήσετε κατά λάθος λάθος κουμπί στον μετρητή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When using KnitNote, I recommend an iPad or a computer with a larger screen, such as a Mac. Patterns and tutorial videos are easier to see, viewing feels more comfortable, and you are less likely to tap the wrong counter control by accident."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosittelen käyttämään KnitNotea iPadilla tai suurempinäyttöisellä tietokoneella, kuten Macilla. Ohjeet ja opetusvideot näkyvät selkeämmin, katselu tuntuu mukavammalta ja laskurin väärää painiketta tulee painettua harvemmin vahingossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser KnitNote, je recommande un iPad ou un ordinateur doté d'un écran plus grand, comme un Mac. Les patrons et les vidéos explicatives sont plus faciles à voir, la lecture est plus confortable et l'on risque moins de toucher par erreur la mauvaise commande du compteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KnitNote を使うときは、iPad や Mac など、画面の大きな端末をおすすめします。編み図や解説動画が見やすく、目にもやさしく感じられ、カウンターの操作をうっかり間違えることも少なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KnitNote를 사용할 때는 iPad나 Mac처럼 화면이 큰 기기를 권합니다. 도안이나 설명 영상을 더 선명하게 볼 수 있어 편안하고, 카운터를 실수로 잘못 누를 가능성도 줄어듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bruker KnitNote, anbefaler jeg en iPad eller en datamaskin med større skjerm, for eksempel en Mac. Da er det lettere å se mønstre og instruksjonsvideoer, visningen blir mer behagelig, og det er mindre fare for å trykke feil på telleren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor KnitNote raad ik een iPad of een computer met een groter scherm aan, zoals een Mac. Patronen en instructievideo's zijn dan beter te zien, het kijken is prettiger en je tikt minder snel per ongeluk op de verkeerde tellerknop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du använder KnitNote rekommenderar jag en iPad eller en dator med större skärm, till exempel en Mac. Mönster och instruktionsvideor blir lättare att se, visningen känns bekvämare och risken att trycka fel på räknaren blir mindre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 KnitNote，我建议大家使用 iPad，或 Mac 等屏幕较大的电脑。看图解或教学视频时会比较清楚，眼睛也不容易疲劳；使用计数器时，也比较不容易误触。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 KnitNote，我建議大家使用 iPad，或 Mac 等螢幕較大的電腦。看織圖或教學影片時會比較清楚，眼睛也不容易疲勞；使用計數器時，也比較不會不小心按錯。"
          }
        }
      }
    },
    "knittingReminder.kind.increase" : {
      "comment" : "System name for the semantic reminder kind that tells the knitter to increase stitches; never used for the optional user note.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Udtagning" } },
