    "backup.restore.recoveryRequired" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genoprettelse og gendannelse mislykkedes begge. Stop med at bruge KnitNote, og gendan appens data fra en enhedsbackup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung und die Wiederherstellung der ursprünglichen Daten sind beide fehlgeschlagen. Verwende KnitNote nicht weiter und stelle die App-Daten aus einem Gerätebackup wieder her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτυχία επαναφοράς και ανάκτησης. Σταματήστε να χρησιμοποιείτε το KnitNote και ανακτήστε τα δεδομένα της εφαρμογής από ένα αντίγραφο ασφαλείας συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore and recovery both failed. Stop using KnitNote and recover the app's data from a device backup."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautus ja palautuminen epäonnistuivat. Lopeta KnitNoten käyttö ja palauta sovelluksen tiedot laitteen varmuuskopiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration et la récupération des données d’origine ont échoué. Cessez d’utiliser KnitNote et restaurez les données de l’app depuis une sauvegarde de l’appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元と元データの回復の両方に失敗しました。KnitNoteの使用を中止し、デバイスのバックアップからアプリのデータを復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원 및 복구 모두 실패했습니다. KnitNote 사용을 중지하고 기기 백업에서 앱 데이터를 복구하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både gjenoppretting og tilbakeføring mislyktes. Slutt å bruke KnitNote og gjenopprett appdataene fra en sikkerhetskopi av enheten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställningen och återhämtningen misslyckades båda. Sluta använda KnitNote och återställ appens data från en enhetssäkerhetskopiering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复和数据回滚均失败。请停止使用 KnitNote，并从设备备份中恢复 App 数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還原與資料回復皆失敗。請停止使用 KnitNote，並從裝置備份復原 App 資料。"
          }
        }
      }
    },
