    "yarn.empty.message" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj garn for at holde detaljer, billeder og lagerbeholdning samlet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Garn hinzu, um Details, Foto und Bestand gemeinsam zu verwalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε νήμα για να διατηρείτε μαζί τα στοιχεία, τη φωτογραφία και το απόθεμά του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add yarn to keep its details, photo, and inventory together."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää lanka, jotta sen tiedot, kuva ja varastosaldo pysyvät yhdessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un fil pour regrouper ses informations, sa photo et son stock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毛糸を追加すると、詳細、写真、在庫をまとめて管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실을 추가해 정보, 사진, 재고를 함께 관리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til garn for å holde detaljene, bildet og lagerbeholdningen sammen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till garn för att hålla detaljer, foto och lagerstatus samman."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加毛线，以集中管理详细信息、照片与库存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增毛線，以集中管理詳細資料、照片與庫存。"
          }
        }
      }
    },
