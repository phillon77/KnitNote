    "yarn.error.archiveUnavailable" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit gemte bibliotek kunne ikke åbnes, så der blev ikke gemt ændringer. Gendan det, eller genstart KnitNote, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Bibliothek konnte nicht geöffnet werden. Es wurden keine Änderungen geschrieben. Stelle sie wieder her oder starte KnitNote neu und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό να ανοίξει η αποθηκευμένη βιβλιοθήκη σας, επομένως δεν καταγράφηκαν αλλαγές. Επαναφέρετέ την ή επανεκκινήστε το KnitNote και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your saved library couldn’t be opened, so no changes were written. Restore it or restart KnitNote, then try again."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettua kirjastoasi ei voitu avata, joten muutoksia ei kirjoitettu. Palauta se tai käynnistä KnitNote uudelleen ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir la bibliothèque enregistrée. Aucune modification n’a été écrite. Restaurez-la ou redémarrez KnitNote, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのライブラリを開けなかったため、変更は書き込まれませんでした。ライブラリを復元するかKnitNoteを再起動して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 라이브러리를 열 수 없으므로 변경 사항이 기록되지 않았습니다. 복원하거나 KnitNote를 다시 시작한 다음 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lagrede biblioteket ditt kunne ikke åpnes, så ingen endringer ble lagret. Gjenopprett det eller start KnitNote på nytt, og prøv igjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt sparade bibliotek kunde inte öppnas, så inga ändringar sparades. Återställ det eller starta om KnitNote och försök igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开已保存的数据库，因此未写入任何更改。请恢复数据或重新启动 KnitNote 后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟已儲存的資料庫，因此未寫入任何變更。請還原資料或重新啟動 KnitNote 後再試一次。"
          }
        }
      }
    },
    "yarn.error.completedProjectLink" : {
      "localizations" : {
        "da" : {
