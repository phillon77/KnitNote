    "backup.error.exportFailed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote konnte keine Sicherung erstellen. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote couldn't create a backup. Please try again."
          }
        },
        "fr" : {
