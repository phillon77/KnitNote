    "unlock.expired.dataRetained" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine projekter, mønstre og noter er sikre. Lås op for at fortsætte med at redigere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Projekte, Muster und Notizen bleiben erhalten. Schalte KnitNote frei, um weiterzuarbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα έργα, τα σχέδια και οι σημειώσεις σας είναι ασφαλή. Ξεκλειδώστε την εφαρμογή για να συνεχίσετε την επεξεργασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your projects, patterns, and notes are safe. Unlock to keep editing."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektisi, ohjeesi ja muistiinpanosi ovat turvassa. Avaa käyttöoikeus jatkaaksesi muokkaamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos projets, patrons et notes sont conservés. Déverrouillez KnitNote pour continuer à les modifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品、編み図、メモはそのまま保存されています。編集を続けるにはアンロックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트, 도안 및 메모는 안전합니다. 계속 편집하려면 잠금을 해제하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine prosjekter, mønstre og notater er trygge. Lås opp for å fortsette å redigere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina projekt, mönster och anteckningar är säkra. Lås upp för att fortsätta redigera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的作品、图解与笔记都会保留。解锁后即可继续编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的作品、織圖與筆記都會保留。解鎖後即可繼續編輯。"
          }
        }
      }
    },
