    "yarn.error.linkedProjectsChanged" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et eller flere tilknyttede projekter er ændret. Gennemgå projektlinkene, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein verknüpftes Projekt wurde geändert. Prüfe die Projektverknüpfungen und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ή περισσότερα συνδεδεμένα έργα άλλαξαν. Ελέγξτε τους συνδέσμους των έργων και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One or more linked projects changed. Review the project links and try again."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi tai useampi linkitetty projekti muuttui. Tarkista projektilinkit ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ou plusieurs projets liés ont changé. Vérifiez les liens des projets et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンク済みの作品が変更されました。作品とのリンクを確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나 이상의 연결된 프로젝트가 변경되었습니다. 프로젝트 링크를 검토한 후 다시 시도하십시오."
