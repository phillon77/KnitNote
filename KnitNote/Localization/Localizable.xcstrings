          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Neulo nostetun lenkin takareunasta oikein, jolloin lenkki kiertyy ja reikä sulkeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Tricoter le brin arrière à l’endroit pour tordre la boucle et fermer le trou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：すくったループの向こう側を表編みし、ねじって穴を閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 들어 올린 고리의 뒤쪽을 겉뜨기해 실이 꼬여 구멍이 닫히게 합니다."
