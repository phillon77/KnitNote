          }
        }
      }
    },
    "stitchDictionary.purl.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå garnet om højre pind, og træk en ny løkke bagud gennem den gamle maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden um die rechte Nadel legen und eine neue Schlinge nach hinten durch die alte Masche ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τυλίξτε το νήμα και τραβήξτε μια νέα θηλιά προς τα πίσω μέσα από τον παλιό πόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap the yarn over the right needle and draw a new loop away from you through the old loop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä lanka oikean puikon ympäri ja vedä uusi lenkki vanhan silmukan läpi taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrouler le fil et tirer une nouvelle boucle vers l’arrière à travers l’ancienne maille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右針に糸をかけ、新しいループを元の目から向こう側へ引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른바늘에 실을 감고 새 고리를 원래 코 사이로 뒤쪽으로 빼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg garnet rundt høyre pinne og trekk en ny løkke bakover gjennom den gamle masken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla het garen om de rechternaald en trek een nieuwe lus naar achteren door de oude lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg garnet runt höger sticka och dra en ny ögla bakåt genom den gamla maskan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将线绕过右针，把新线圈穿过旧线圈往后拉出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將線繞過右針，把新線圈穿過舊線圈往後拉出。"
          }
        }
      }
    },
    "stitchDictionary.purl.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Slå garnet om højre pind, og træk en ny løkke bagud gennem den gamle maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnung: Den Faden um die rechte Nadel legen und eine neue Schlinge nach hinten durch die alte Masche ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Τυλίξτε το νήμα και τραβήξτε μια νέα θηλιά προς τα πίσω μέσα από τον παλιό πόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: Wrap the yarn over the right needle and draw a new loop away from you through the old loop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Kierrä lanka oikean puikon ympäri ja vedä uusi lenkki vanhan silmukan läpi taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Enrouler le fil et tirer une nouvelle boucle vers l’arrière à travers l’ancienne maille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：右針に糸をかけ、新しいループを元の目から向こう側へ引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 오른바늘에 실을 감고 새 고리를 원래 코 사이로 뒤쪽으로 빼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Legg garnet rundt høyre pinne og trekk en ny løkke bakover gjennom den gamle masken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Sla het garen om de rechternaald en trek een nieuwe lus naar achteren door de oude lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Lägg garnet runt höger sticka och dra en ny ögla bakåt genom den gamla maskan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：将线绕过右针，把新线圈穿过旧线圈往后拉出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：將線繞過右針，把新線圈穿過舊線圈往後拉出。"
          }
        }
      }
    },
    "stitchDictionary.purl.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad den gamle maske glide af venstre pind; behold den nye på højre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Masche von der linken Nadel gleiten lassen; die neue bleibt rechts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τον παλιό πόντο να βγει από την αριστερή βελόνα· ο νέος μένει δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the old loop from the left needle; keep the new loop on the right."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota vanha silmukka vasemmalta puikolta; uusi jää oikealle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire tomber l’ancienne maille de l’aiguille gauche ; garder la nouvelle à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の目を左針から外し、新しい目を右針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 코를 왼바늘에서 빼고 새 코는 오른바늘에 남깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La den gamle masken gli av venstre pinne; behold den nye på høyre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de oude lus van de linkernaald glijden; de nieuwe blijft rechts."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt den gamla maskan glida av vänster sticka; behåll den nya på höger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧线圈滑离左针，新线圈留在右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊線圈滑離左針，新線圈留在右針。"
          }
        }
      }
    },
