    "yarn.error.linkedProjectsChanged" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et eller flere tilknyttede projekter er ændret. Gennemgå projektlinkene, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein verknüpftes Projekt wurde geändert. Prüfe die Projektverknüpfungen und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ή περισσότερα συνδεδεμένα έργα άλλαξαν. Ελέγξτε τους συνδέσμους των έργων και δοκιμάστε ξανά."
          }
