          }
        }
      }
    },
    "yarn.error.loadFailed.message" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote viser ikke et tomt bibliotek eller gemmer ændringer, mens arkivet er ulæseligt. Genvind adgang til den gemte fil, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange das Archiv nicht lesbar ist, zeigt KnitNote keine leere Bibliothek an und speichert keine Änderungen. Stelle den Zugriff auf die gespeicherte Datei wieder her und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το KnitNote δεν θα εμφανίσει κενή βιβλιοθήκη ούτε θα αποθηκεύσει αλλαγές όσο το αρχείο δεν είναι αναγνώσιμο. Αποκαταστήστε την πρόσβαση στο αποθηκευμένο αρχείο και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote won’t show an empty library or save changes while the archive is unreadable. Restore access to the saved file, then retry."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote ei näytä tyhjää kirjastoa eikä tallenna muutoksia, kun arkistoa ei voi lukea. Palauta tallennetun tiedoston käyttöoikeus ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que l’archive est illisible, KnitNote n’affiche pas de bibliothèque vide et n’enregistre aucune modification. Rétablissez l’accès au fichier enregistré, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブを読み込めない間、KnitNoteは空のライブラリを表示せず、変更も保存しません。保存済みファイルへのアクセスを復元して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관 파일을 읽을 수 없는 동안 KnitNote는 빈 라이브러리를 표시하거나 변경 사항을 저장하지 않습니다. 저장된 파일에 대한 접근을 복원한 다음 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote vil ikke vise et tomt bibliotek eller lagre endringer mens arkivet er ulestelig. Gjenopprett tilgang til den lagrede filen, og prøv igjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote visar inte ett tomt bibliotek eller sparar ändringar medan arkivet är oläsbart. Återställ åtkomst till den sparade filen och försök igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存档无法读取时，KnitNote 不会显示空数据库或保存更改。请先恢复已保存文件的访问权限，再重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存檔無法讀取時，KnitNote 不會顯示空資料庫或儲存變更。請先恢復已儲存檔案的存取權，再試一次。"
          }
        }
      }
    },
