          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上1目交差"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 한 코 두고 교차뜨기 (1/1 LC, 설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
