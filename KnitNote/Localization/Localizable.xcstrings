    "backup.error.operationInProgress" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden databehandling er allerede i gang. Vent venligst og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Datenvorgang läuft bereits. Bitte warten und erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια άλλη λειτουργία δεδομένων βρίσκεται ήδη σε εξέλιξη. Περιμένετε και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another data operation is already in progress. Please wait and try again."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen tietotoiminto on jo käynnissä. Odota ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre opération sur les données est déjà en cours. Patientez et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデータ操作がすでに進行中です。お待ちください。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 데이터 작업이 이미 진행 중입니다. 잠시 기다린 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen databehandling er allerede i gang. Vennligst vent og prøv igjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan databehandling pågår redan. Vänligen vänta och försök igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一项数据操作正在进行，请稍候再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一項資料操作正在進行，請稍候再試。"
          }
        }
      }
    },
    "backup.error.storageOrAccess" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
