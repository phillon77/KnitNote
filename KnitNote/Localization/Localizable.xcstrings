    "backup.error.storageOrAccess" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote konnte nicht auf die Sicherung zugreifen oder der Speicherplatz reicht nicht aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote couldn't access the backup, or there isn't enough storage space."
