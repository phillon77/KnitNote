        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Παράδειγμα ανάμεσα σε δύο καλούς πόντους: φέρτε το νήμα μπροστά ανάμεσα στις άκρες των βελονών."
          }
        },
        "en": {
          "stringUnit": {
