    "knittingReminder.editor.validation" : {
      "comment" : "Field-adjacent validation copy: first target must be a whole number at least 0; repeating interval and finite occurrence count must be whole numbers at least 1.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Første pind skal være et heltal fra og med 0. Interval og antal gange skal være heltal fra og med 1." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die erste Reihe muss eine ganze Zahl ab 0 sein. Intervall und Anzahl müssen ganze Zahlen ab 1 sein." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Η πρώτη σειρά πρέπει να είναι ακέραιος αριθμός από 0 και πάνω. Το διάστημα και ο αριθμός επαναλήψεων πρέπει να είναι ακέραιοι από 1 και πάνω." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "First row must be a whole number that is at least 0. Interval and number of times must be whole numbers that are at least 1." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Ensimmäisen kerroksen on oltava kokonaisluku, joka on vähintään 0. Välin ja kertojen määrän on oltava kokonaislukuja, jotka ovat vähintään 1." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le premier rang doit être un entier supérieur ou égal à 0. L’intervalle et le nombre de fois doivent être des entiers supérieurs ou égaux à 1." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初の段は0以上の整数、間隔と回数は1以上の整数で入力してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "첫 단은 0 이상의 정수여야 합니다. 간격과 횟수는 1 이상의 정수여야 합니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Første rad må være et heltall fra og med 0. Intervall og antall ganger må være heltall fra og med 1." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De eerste toer moet een geheel getal van 0 of hoger zijn. Het interval en het aantal keren moeten gehele getallen van 1 of hoger zijn." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Första varvet måste vara ett heltal från 0. Intervall och antal gånger måste vara heltal från 1." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第一行须为 0 以上的整数；间隔和次数须为 1 以上的整数。" } },
