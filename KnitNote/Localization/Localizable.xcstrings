            "value": "Tekening: Laat de opgenomen lus los. Er is één steek bij; de volgende steek hoort niet bij M1L."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Släpp den lyfta öglan. En maska har lagts till; nästa maska ingår inte i M1L."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：挑起的线圈滑离左针，增加一针；下一针不属于 M1L。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：挑起的線圈滑離左針，增加一針；下一針不屬於 M1L。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højrehældende udtagning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts geneigte Zunahme"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αύξηση με κλίση δεξιά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one right"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikealle kallistuva lisäys"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentation intercalaire droite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右傾斜のねじり増し目（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른코 늘리기-겉뜨기 (M1R)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyrevendt økning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtshellend meerderen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högerlutande ökning"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右倾扭加针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右傾扭加針"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej lænken mellem maskerne, og tilføj én højrehældende maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Querfaden verdrehen und eine rechts geneigte Masche hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρίψτε το νήμα ανάμεσα σε πόντους για μία αύξηση με κλίση δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twist the strand between stitches to add one right-leaning stitch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä silmukoiden välinen lanka yhdeksi oikealle kallistuvaksi lisäsilmukaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tordre le fil entre les mailles pour ajouter une maille inclinée à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡り糸をねじって、右に傾く目を1目増やします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코 사이의 가로실을 꼬아 오른쪽으로 기우는 코를 하나 늘립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri tråden mellom maskene og legg til én høyrevendt maske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De draad tussen steken verdraaien voor één rechtshellende steek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid tråden mellan maskorna och lägg till en högerlutande maska."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起针间横线扭织，增加一个右倾针目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起針間橫線扭織，增加一個右傾針目。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft lænken mellem maskerne med venstre pind bagfra og frem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Querfaden zwischen den Maschen mit der linken Nadel von hinten nach vorn aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σηκώστε το ενδιάμεσο νήμα με την αριστερή βελόνα από πίσω προς τα εμπρός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the left needle, lift the strand between stitches from back to front."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta silmukoiden välinen lanka vasemmalla puikolla takaa eteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’aiguille gauche, relever le fil entre les mailles de l’arrière vers l’avant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目と目の間の渡り糸を、左針で向こうから手前へすくいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼바늘로 코 사이의 가로실을 뒤에서 앞으로 들어 올립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft tråden mellom maskene med venstre pinne bakfra og fremover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem met de linkernaald de tussendraad van achteren naar voren op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft tråden mellan maskorna med vänster sticka bakifrån och framåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用左针由后往前挑起两针之间的横线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用左針由後往前挑起兩針之間的橫線。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.accessibility.1": {
