    "stitchDictionary.cable-right-two.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bagved. Strik næste maske på venstre pind ret; behold den hvilende maske bagved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden hinten. Die nächste Masche der linken Nadel rechts stricken; die wartende Masche bleibt hinten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα πίσω. Πλέξτε καλή τον επόμενο πόντο της αριστερής βελόνας· κρατήστε τον πόντο σε αναμονή πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With yarn behind, knit the next stitch from the left needle; keep the held stitch behind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka takana. Neulo vasemman puikon seuraava silmukka oikein; pidä odottava silmukka takana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil derrière, tricoter la maille suivante de l’aiguille gauche à l’endroit ; garder la maille en attente derrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、左針の次の目を表編みします。休めた目は向こう側に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 왼바늘의 다음 코를 겉뜨기합니다. 보류한 코는 뒤에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bak. Strikk neste maske på venstre pinne rett; behold den hvilende masken bak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen achter. Brei de volgende steek van de linkernaald recht; houd de wachtende steek achter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bakom. Sticka nästa maska från vänster sticka rätt; håll den väntande maskan bakom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于后方，织左针的下一针；麻花针保持在后方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於後方，織左針的下一針；麻花針保持在後方。"
          }
        }
      }
    },
    "stitchDictionary.cable-right-two.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
