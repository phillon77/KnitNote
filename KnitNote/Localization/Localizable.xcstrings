    "stitchDictionary.symbol.unavailable": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bekræftet symbolvariant er medtaget. Se trinene og opskriftens tegnforklaring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine geprüfte Symbolvariante enthalten. Schritte und Musterlegende beachten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν περιλαμβάνεται επαληθευμένο σύμβολο. Δείτε τα βήματα και το υπόμνημα του σχεδίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No verified symbol variant is included. Read the steps and your pattern key."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmistettua merkkiä ei ole mukana. Katso vaiheet ja ohjeen merkkiselite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun symbole vérifié n’est inclus. Consultez les étapes et la légende du patron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できた記号は未掲載です。手順と編み図の凡例を参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 기호를 싣지 않았습니다. 단계와 도안의 기호 설명을 참고하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bekreftet symbolvariant er tatt med. Se trinnene og mønsterets tegnforklaring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen geverifieerd symbool opgenomen. Lees de stappen en de legenda van je patroon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen verifierad symbolvariant ingår. Läs stegen och mönstrets teckenförklaring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收录已核实的符号，请参考步骤及原图解图例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未收錄已核實的符號，請參考步驟及原織圖圖例。"
