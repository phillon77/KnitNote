    "calculator.adjustment.rows.failure.insufficientRows" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke nok pinde til at fordele disse ændringer én gang pr. pind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt nicht genug Reihen, um diese Änderungen höchstens einmal pro Reihe zu verteilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν αρκετές σειρές για τη διανομή αυτών των αλλαγών μία φορά ανά σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are not enough rows to distribute these changes once per row."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitä muutoksia ei voida jakaa kerros kerrallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas assez de rangs pour répartir ces changements à raison d’un par rang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定した段数では、1段につき1回ずつ均等に配置できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단마다 한 번씩 변경하려면 단 수가 부족합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke nok rader til å fordele disse endringene én gang per rad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inte tillräckligt många varv för att distribuera dessa ändringar en gång per varv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定行数不足，无法按每行最多一次均匀分配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定段數不足，無法以每段最多一次平均完成。"
          }
        }
      }
    },
    "calculator.adjustment.rows.failure.symmetricEven" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast et lige antal masker for at matche ændringerne på begge sider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für gleiche Änderungen auf beiden Seiten eine gerade Maschenzahl eingeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ίδιες αλλαγές και στις δύο πλευρές, εισαγάγετε έναν άρτιο αριθμό πόντων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For matching changes on both sides, enter an even number of stitches."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
