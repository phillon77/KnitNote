          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両側を同じように調整する場合は、偶数の目数を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양쪽을 똑같이 조정하려면 짝수 개의 코를 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For like endringer på begge sider må masketallet være et partall."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
