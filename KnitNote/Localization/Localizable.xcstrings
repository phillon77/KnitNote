    "patterns.backup.reminder.message" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mønstre gemmes kun på denne enhed. Eksporter en manuel sikkerhedskopi fra Indstillinger for at opbevare en separat kopi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muster werden nur auf diesem Gerät gespeichert. Exportiere in den Einstellungen eine manuelle Sicherung, um eine separate Kopie aufzubewahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σχέδια αποθηκεύονται μόνο σε αυτή τη συσκευή. Εξαγάγετε ένα χειροκίνητο αντίγραφο ασφαλείας από τις Ρυθμίσεις για να διατηρήσετε ξεχωριστό αντίγραφο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patterns are stored only on this device. Export a manual backup from Settings to keep a separate copy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjeet tallennetaan vain tähän laitteeseen. Vie manuaalinen varmuuskopio Asetuksista säilyttääksesi erillisen kopion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les patrons ne sont stockés que sur cet appareil. Exportez une sauvegarde manuelle depuis Paramètres pour conserver une copie séparée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編み図はこのデバイスにのみ保存されます。設定から手動バックアップをエクスポートして、別のコピーを保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도안은 이 기기에서만 저장됩니다. 설정에서 수동 백업을 내보내 별도의 사본을 보관하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mønstre lagres kun på denne enheten. For å lagre en separat kopi, eksporter en manuell sikkerhetskopi fra Innstillinger."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mönster lagras endast på den här enheten. Exportera en manuell säkerhetskopia från Inställningar för att behålla en separat kopia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图解仅保存在此设备上。请前往设置手动导出备份，并另外保存一份副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "織圖只保存在這部裝置上。請前往設定手動匯出備份，另外保存一份副本。"
          }
        }
      }
    },
