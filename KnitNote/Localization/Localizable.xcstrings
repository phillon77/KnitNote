        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリマインダーは別の画面で変更されました。開き直して、もう一度お試しください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 알림이 다른 화면에서 변경되었습니다. 다시 연 후 다시 시도하세요." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Denne påminnelsen ble endret et annet sted. Åpne den på nytt og prøv igjen." } },
