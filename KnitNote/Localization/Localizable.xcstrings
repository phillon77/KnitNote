    "art.familyHero.accessibility" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mor strikker under en akvarelhimmel ved siden af kaninen Lemon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Mutter strickt unter einem Aquarellhimmel, neben ihr Hase Lemon."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια μητέρα πλέκει κάτω από έναν ουρανό ακουαρέλας, δίπλα στον Lemon, το κουνέλι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mother knitting in a watercolor sky beside Lemon the rabbit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äiti neuloo vesiväritaivaan alla Lemon-kani vierellään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mère tricote sous un ciel aquarellé, avec le lapin Lemon à ses côtés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水彩の空の下で編み物をする母親と、寄り添うウサギのLemon。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토끼 레몬 옆의 수채화 하늘에서 뜨개질을 하는 엄마."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mor strikker i et akvarellhimmelbilde ved siden av kaninen Lemon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mamma som stickar i en akvarellhimmel bredvid kaninen Lemon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "妈妈在水彩天空下编织，宠物兔 Lemon 陪在身旁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媽媽在水彩天空下編織，寵物兔 Lemon 陪在身旁。"
          }
        }
      }
    },
