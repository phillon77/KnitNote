        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立 KnitNote 備份，請再試一次。"
          }
        }
      }
    },
    "backup.error.invalid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sicherung ist beschädigt oder unvollständig und kann nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup is damaged or incomplete and can't be restored."
          }
        },
        "fr" : {
