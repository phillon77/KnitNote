    "yarn.error.loadFailed.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange das Archiv nicht lesbar ist, zeigt KnitNote keine leere Bibliothek an und speichert keine Änderungen. Stelle den Zugriff auf die gespeicherte Datei wieder her und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KnitNote won’t show an empty library or save changes while the archive is unreadable. Restore access to the saved file, then retry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que l’archive est illisible, KnitNote n’affiche pas de bibliothèque vide et n’enregistre aucune modification. Rétablissez l’accès au fichier enregistré, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブを読み込めない間、KnitNoteは空のライブラリを表示せず、変更も保存しません。保存済みファイルへのアクセスを復元して、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
