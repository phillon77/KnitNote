    "unlock.watch.guidance" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås op på iPhone, iPad eller Mac. Apple Watch følger din KnitNote-adgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf iPhone, iPad oder Mac freischalten. Die Apple Watch übernimmt deinen KnitNote-Zugriff."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώστε σε iPhone, iPad ή Mac. Το Apple Watch χρησιμοποιεί την ίδια πρόσβαση KnitNote."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock on iPhone, iPad, or Mac. Apple Watch follows your KnitNote access."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa käyttöoikeus iPhonella, iPadilla tai Macilla. Apple Watch käyttää samaa KnitNote-käyttöoikeutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez KnitNote sur iPhone, iPad ou Mac. L’Apple Watch reprend votre accès à KnitNote."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone、iPad、またはMacでアンロックしてください。Apple WatchにもKnitNoteの利用権が反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, iPad 또는 Mac에서 잠금을 해제하세요. Apple Watch도 동일한 KnitNote 이용 권한을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås opp på iPhone, iPad eller Mac. Apple Watch følger med på din KnitNote-tilgang."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås upp på iPhone, iPad eller Mac. Apple Watch följer din KnitNote-åtkomst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iPhone、iPad 或 Mac 解锁；Apple Watch 会同步 KnitNote 的使用权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 iPhone、iPad 或 Mac 解鎖；Apple Watch 會同步 KnitNote 的使用權限。"
          }
        }
      }
    },
