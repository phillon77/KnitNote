    "knittingReminder.error.stale" : {
      "comment" : "Recovery error shown when an occurrence or rule revision changed after this UI captured it.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Denne påmindelse blev ændret et andet sted. Åbn den igen, og prøv igen." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Erinnerung wurde an anderer Stelle geändert. Öffne sie erneut und versuche es noch einmal." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Αυτή η υπενθύμιση άλλαξε αλλού. Ανοίξτε την ξανά και δοκιμάστε πάλι." } },
