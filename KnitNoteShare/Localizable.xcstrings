    "share.entitlement.blocked" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine eksisterende data er sikre. Din prøveperiode er afsluttet, eller KnitNote skal opdatere din adgang. Åbn KnitNote for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine vorhandenen Daten bleiben sicher. Deine Testphase ist abgelaufen oder KnitNote muss deinen Zugriff aktualisieren. Öffne KnitNote, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα υπάρχοντα δεδομένα σας είναι ασφαλή. Η δοκιμαστική περίοδος έληξε ή το KnitNote πρέπει να ανανεώσει την πρόσβασή σας. Ανοίξτε το KnitNote για να συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your existing data is safe. Your trial has ended or KnitNote needs to refresh your access. Open KnitNote to continue."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyiset tietosi ovat turvassa. Kokeilujaksosi on päättynyt tai KnitNoten on päivitettävä käyttöoikeutesi. Jatka avaamalla KnitNote."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données existantes sont conservées. Votre essai est terminé ou KnitNote doit actualiser votre accès. Ouvrez KnitNote pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のデータは安全に保管されています。トライアルが終了したか、KnitNoteで利用権を更新する必要があります。続けるにはKnitNoteを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 기존 데이터는 안전합니다. 귀하의 체험 기간이 종료되었거나 KnitNote에서 귀하의 액세스를 새로 고쳐야 합니다. KnitNote를 열어 계속 진행하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine eksisterende data er trygge. Prøvetiden din er over, eller KnitNote må oppdatere tilgangen din. Åpne KnitNote for å fortsette."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina befintliga uppgifter är säkra. Din provperiod har slutat eller KnitNote behöver uppdatera din åtkomst. Öppna KnitNote för att fortsätta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你现有的数据仍安全保留。试用期已结束，或 KnitNote 需要刷新你的使用权限。请打开 KnitNote 以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你現有的資料仍安全保留。試用期已結束，或 KnitNote 需要重新確認你的使用權限。請開啟 KnitNote 以繼續。"
          }
        }
      }
    },
