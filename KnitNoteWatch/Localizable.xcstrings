          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld Erinnerungen überschritten" } }
        } } },
        "el" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "Έγινε υπέρβαση %lld υπενθύμισης" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "Έγινε υπέρβαση %lld υπενθυμίσεων" } }
        } } },
        "en" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld reminder crossed" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld reminders crossed" } }
        } } },
        "fi" : { "variations" : { "plural" : {
