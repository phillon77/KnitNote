{
  "sourceLanguage" : "en",
  "strings" : {
    "watch.reminder.accessibility.summary" : {
      "comment" : "Combined Watch VoiceOver summary. %1$@ is the localized kind; %2$@ is the verbatim user note; %3$@ is the localized original target; %4$@ is the localized phase; %5$@ is the localized queue position.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Type: %1$@; note: %2$@; %3$@; fase: %4$@; kø: %5$@" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Typ: %1$@; Notiz: %2$@; %3$@; Phase: %4$@; Warteschlange: %5$@" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Τύπος: %1$@· σημείωση: %2$@· %3$@· φάση: %4$@· ουρά: %5$@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Type: %1$@; note: %2$@; %3$@; phase: %4$@; queue: %5$@" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Tyyppi: %1$@; huomautus: %2$@; %3$@; vaihe: %4$@; jono: %5$@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Type : %1$@ ; note : %2$@ ; %3$@ ; phase : %4$@ ; file : %5$@" } },
