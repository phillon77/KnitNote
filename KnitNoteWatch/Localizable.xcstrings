        "ko" : { "stringUnit" : { "state" : "translated", "value" : "유형: %1$@; 메모: %2$@; %3$@; 단계: %4$@; 대기열: %5$@" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Type: %1$@; notat: %2$@; %3$@; fase: %4$@; kø: %5$@" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Type: %1$@; notitie: %2$@; %3$@; fase: %4$@; wachtrij: %5$@" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Typ: %1$@; anteckning: %2$@; %3$@; fas: %4$@; kö: %5$@" } },
