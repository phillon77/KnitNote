{
  "sourceLanguage" : "en",
  "strings" : {
    "counter.reminder.complete" : {
      "comment" : "Compact action label that acknowledges every row-counter reminder occurrence shown on Apple Watch.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Fuldfør denne påmindelse" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Erinnerung abschließen" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ολοκλήρωση αυτής της υπενθύμισης" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Complete this reminder" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Suorita tämä muistutus" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Terminer ce rappel" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリマインダーを完了" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 알림 완료" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Fullfør denne påminnelsen" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Slutför den här påminnelsen" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成此提醒" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "完成這個提醒" } }
      }
    },
    "counter.reminder.complete.hint" : {
      "comment" : "VoiceOver hint for completing a row-counter reminder on Apple Watch.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Bekræfter passerede pinde og går til næste mål." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bestätigt die überschrittenen Reihen und geht zum nächsten Ziel." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Επιβεβαιώνει τις σειρές που ξεπεράστηκαν και προχωρά στον επόμενο στόχο." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Acknowledges the crossed rows and advances to the next target." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Kuittaa ohitetut kerrokset ja siirtyy seuraavaan tavoitteeseen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Confirme les rangs franchis et passe à la prochaine cible." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "通過した段を確認し、次の目標へ進みます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지나간 단을 확인하고 다음 목표로 이동합니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Bekrefter passerte rader og går til neste mål." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Bekräftar passerade varv och går till nästa mål." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确认已跨过的行数，并前往下一个目标。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認已跨過的段數，並前往下一個目標。" } }
      }
    },
    "counter.reminder.crossedCount" : {
      "comment" : "Compact pluralized count of row-counter reminder occurrences crossed on Apple Watch.",
      "localizations" : {
        "da" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld påmindelse passeret" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld påmindelser passeret" } }
        } } },
        "de" : { "variations" : { "plural" : {
