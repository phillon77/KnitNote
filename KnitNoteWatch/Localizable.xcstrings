        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "類型：%1$@；補充文字：%2$@；%3$@；階段：%4$@；佇列：%5$@" } }
      }
    },
    "watch.reminder.action.complete" : {
      "comment" : "Compact Watch button label that completes the current reminder occurrence, not the whole rule.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Færdig" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fertig" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ολοκλήρωση" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Complete" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Valmis" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Terminé" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "完了" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Ferdig" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Gereed" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Klar" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "完成" } }
      }
    },
    "watch.reminder.action.complete.hint" : {
      "comment" : "Watch accessibility hint explaining that Complete handles only the current occurrence.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Markerer denne påmindelse som fuldført." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Markiert dieses Erinnerungsvorkommen als abgeschlossen." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Σημειώνει αυτή την εμφάνιση υπενθύμισης ως ολοκληρωμένη." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Marks this reminder occurrence complete." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Merkitsee tämän muistutuskerran valmiiksi." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Marque cette occurrence de rappel comme terminée." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今回のリマインダーを完了にします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번 알림을 완료로 표시합니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Markerer denne påminnelsen som fullført." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Markeert deze herinneringskeer als voltooid." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Markerar den här påminnelseförekomsten som slutförd." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将此次提醒标记为已完成。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將這次提醒標記為已完成。" } }
      }
    },
    "watch.reminder.action.defer" : {
      "comment" : "Compact Watch initial-phase button that defers the occurrence until the next upward row change.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Påmind på næste pind" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "In der nächsten Reihe erinnern" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Υπενθύμιση στην επόμενη σειρά" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Remind Next Row" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Muistuta seuraavalla kerroksella" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappel au rang suivant" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次の段で再通知" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 단에 알림" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Påminn på neste rad" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Herinner bij de volgende toer" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Påminn nästa varv" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一行再提醒" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下一段再提醒" } }
      }
    },
    "watch.reminder.action.defer.hint" : {
      "comment" : "Watch accessibility hint explaining that the occurrence will appear again after the next row.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Viser denne påmindelse igen efter næste pind." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt diese Erinnerung nach der nächsten Reihe erneut." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Εμφανίζει ξανά αυτή την υπενθύμιση μετά την επόμενη σειρά." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows this reminder again after the next row." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Näyttää tämän muistutuksen uudelleen seuraavan kerroksen jälkeen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Affiche de nouveau ce rappel après le rang suivant." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次の段の後に、このリマインダーをもう一度表示します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 단 후에 이 알림을 다시 표시합니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Viser denne påminnelsen igjen etter neste rad." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Toont deze herinnering opnieuw na de volgende toer." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Visar den här påminnelsen igen efter nästa varv." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一行后再次显示此提醒。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下一段後再次顯示這個提醒。" } }
      }
    },
    "watch.reminder.action.skip" : {
      "comment" : "Compact Watch deferred-phase button that skips this occurrence without stopping its rule.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Spring over denne gang" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diesmal überspringen" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Παράλειψη αυτής της φοράς" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip This Time" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Ohita tämä kerta" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ignorer cette fois" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今回はスキップ" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번 건너뛰기" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Hopp over denne gangen" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deze keer overslaan" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Hoppa över den här gången" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过此次" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "略過這次" } }
      }
    },
    "watch.reminder.action.skip.hint" : {
      "comment" : "Watch accessibility hint explaining that Skip affects only the occurrence currently shown.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Springer kun denne påmindelse over." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Überspringt nur dieses Erinnerungsvorkommen." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Παραλείπει μόνο αυτή την εμφάνιση υπενθύμισης." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Skips only this reminder occurrence." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Ohittaa vain tämän muistutuskerran." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ignore uniquement cette occurrence du rappel." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今回のリマインダーだけをスキップします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번 알림만 건너뜁니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Hopper bare over denne påminnelsen." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Slaat alleen deze herinneringskeer over." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Hoppar bara över den här påminnelseförekomsten." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅跳过此次提醒。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只略過這次提醒。" } }
      }
    },
