          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld muistutusta ohitettu" } }
        } } },
        "fr" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld rappel franchi" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld rappels franchis" } }
        } } },
        "ja" : { "variations" : { "plural" : {
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld 件のリマインダーを通過" } }
        } } },
        "ko" : { "variations" : { "plural" : {
          "other" : { "stringUnit" : { "state" : "translated", "value" : "알림 %lld개를 지났습니다" } }
        } } },
        "nb" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld påminnelse passert" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld påminnelser passert" } }
        } } },
        "sv" : { "variations" : { "plural" : {
          "one" : { "stringUnit" : { "state" : "translated", "value" : "%lld påminnelse passerad" } },
          "other" : { "stringUnit" : { "state" : "translated", "value" : "%lld påminnelser passerade" } }
        } } },
        "zh-Hans" : { "variations" : { "plural" : {
          "other" : { "stringUnit" : { "state" : "translated", "value" : "已跨过 %lld 个提醒" } }
        } } },
        "zh-Hant" : { "variations" : { "plural" : {
          "other" : { "stringUnit" : { "state" : "translated", "value" : "已跨過 %lld 個提醒" } }
        } } }
      }
    },
    "counter.reminder.reached" : {
      "comment" : "Compact row-counter reminder message on Apple Watch; %lld is the latest reached row.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Nåede pind %lld." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Reihe %lld erreicht." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Έφτασε στη σειρά %lld." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reached row %lld." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Kerros %lld saavutettu." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rang %lld atteint." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 段目に到達しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld단에 도달했습니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Nådde rad %lld." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Nådde varv %lld." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已到达第 %lld 行。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已到達第 %lld 段。" } }
      }
    },
    "counter.reminder.stop" : {
      "comment" : "Compact destructive action label that disables a row-counter reminder on Apple Watch.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Stop påmindelse" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung stoppen" } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Διακοπή υπενθύμισης" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop reminder" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Lopeta muistutus" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Arrêter le rappel" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを停止" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "알림 중지" } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Stopp påminnelsen" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Stoppa påminnelsen" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止提醒" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停止提醒" } }
      }
    },
    "counter.reminder.stop.hint" : {
      "comment" : "VoiceOver hint for stopping a row-counter reminder on Apple Watch.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Slår påmindelsen fra og rydder ventende pinde." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schaltet diese Erinnerung aus und löscht ausstehende Reihen." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Απενεργοποιεί την υπενθύμιση και διαγράφει τις σειρές σε αναμονή." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turns off this reminder and clears its pending rows." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Poistaa muistutuksen käytöstä ja tyhjentää odottavat kerrokset." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactive ce rappel et efface les rangs en attente." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリマインダーをオフにして保留中の段を消去します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 알림을 끄고 대기 중인 단을 지웁니다." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Slår av påminnelsen og fjerner ventende rader." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Stänger av påminnelsen och rensar väntande varv." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭此提醒，并清除待处理的行数。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉這個提醒，並清除待處理的段數。" } }
      }
    },
