    "stitchDictionary.symbol.unavailable": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bekræftet symbolvariant er medtaget. Se trinene og opskriftens tegnforklaring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine geprüfte Symbolvariante enthalten. Schritte und Musterlegende beachten."
