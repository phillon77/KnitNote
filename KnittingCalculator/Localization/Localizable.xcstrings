          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Lanka takana. Nosta kaksi silmukkaa oikein neulomatta, yksi kerrallaan, oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Fil derrière, glisser deux mailles une par une comme à l’endroit sur l’aiguille droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：糸を向こう側に置き、2目を1目ずつ表目の向きに右針へすべらせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 실을 뒤에 두고 두 코를 한 코씩 겉뜨기 방향으로 오른바늘에 옮깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet bak. Ta to masker løs av som rett, én om gangen, på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Garen achter. Haal twee steken één voor één recht af op de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Garnet bakom. Lyft två maskor som räta, en i taget, till höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：线置于后方，以下针方向一次一针，将两针滑到右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：線置於後方，以下針方向一次一針，將兩針滑到右針。"
          }
        }
      }
    },
    "stitchDictionary.ssk.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stik venstre pind ind foran i de to løse masker, og strik dem ret sammen gennem de bagerste lænker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die linke Nadel vorn in beide abgehobenen Maschen stechen und beide durch die hinteren Glieder rechts zusammenstricken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλτε την αριστερή βελόνα στο μπροστινό μέρος των δύο άπλεκτων πόντων και πλέξτε τους μαζί καλή από τα πίσω σκέλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert the left needle through the fronts of both slipped loops; knit them together through their back loops."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työnnä vasen puikko nostettujen silmukoiden etupuolelta läpi ja neulo ne takareunoista oikein yhteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piquer l’aiguille gauche dans l’avant des deux mailles glissées et les tricoter ensemble à l’endroit par les brins arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左針を2つのすべり目の手前側に入れ、向こう側のループを一緒に表編みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼바늘을 옮긴 두 코의 앞쪽에 넣고, 두 코의 뒤쪽을 함께 겉뜨기합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stikk venstre pinne inn foran i begge løse masker og strikk dem rett sammen gjennom bakre maskeledd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steek de linkernaald door de voorkant van beide afgehaalde lussen en brei ze recht samen door de achterste lussen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick vänster sticka genom framsidan av båda lyfta maskorna och sticka dem rätt tillsammans genom de bakre bågarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左针穿入两个滑针的前方，再从后半针将两针一起织下针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左針穿入兩個滑針的前方，再從後半針將兩針一起織下針。"
          }
        }
      }
    },
    "stitchDictionary.ssk.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
