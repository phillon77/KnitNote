    "stitchDictionary.knit-front-back.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret i forreste og bagerste lænke"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorn und hinten rechts herausstricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλή μπροστά και πίσω"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit front and back"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo etu- ja takareunasta oikein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter devant et derrière"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ目の前後を表編み（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉뜨기 코늘림 (KFB)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett i fremre og bakre maskeledd"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor- en achterin recht breien"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rätt i främre och bakre maskbågen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一针的前侧和后侧各织一下针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同針目前後各織一下針"
          }
        }
      }
    },
    "stitchDictionary.knit-front-back.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik to masker i én eksisterende maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einer vorhandenen Masche zwei Maschen bilden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε δύο πόντους από έναν υπάρχοντα πόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make two stitches from one existing stitch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo kaksi silmukkaa yhdestä vanhasta silmukasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Former deux mailles dans une seule maille existante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の1目から2目を編み出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 한 코에서 두 코를 만듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk to masker fra én eksisterende maske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit één bestaande steek twee steken breien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka två maskor ur en befintlig maska."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从同一个旧针目织出两针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從同一個舊針目織出兩針。"
          }
        }
      }
    },
    "stitchDictionary.knit-front-back.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik ret i maskens forreste lænke; behold den gamle maske på venstre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Masche durch das vordere Maschenglied rechts stricken und die alte Masche links behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε καλή στο μπροστινό σκέλος· κρατήστε τον αρχικό πόντο στην αριστερή βελόνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit into the front of the stitch; keep the original loop on the left needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo silmukan etureunasta oikein; pidä vanha silmukka vasemmalla puikolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter le brin avant à l’endroit ; garder la maille d’origine sur l’aiguille gauche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目の手前側を表編みし、元の目を左針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코의 앞쪽을 겉뜨기하고 원래 코는 왼바늘에 남깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk rett i fremre maskeledd; behold den gamle masken på venstre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei recht in de voorste lus; laat de oorspronkelijke steek op de linkernaald staan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka rätt i främre maskbågen; behåll den gamla maskan på vänster sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先织旧针目的前半针，旧线圈保留在左针上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先織舊針目的前半針，舊線圈保留在左針上。"
          }
        }
      }
    },
