    "stitchDictionary.p2tog.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To vrang sammen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei links zusammenstricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο μαζί ανάποδη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purl two together"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi nurin yhteen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux mailles ensemble à l’envers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2目を一緒に裏編み（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 코 모아 안뜨기 (P2TOG, 설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To vrang sammen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee averecht samenbreien"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två aviga tillsammans"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上针两针并一针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上針兩針併一針"
          }
        }
      }
    },
    "stitchDictionary.p2tog.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik to masker sammen til én vrangmaske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Maschen zusammen als eine linke Masche arbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε δύο πόντους μαζί ως έναν ανάποδο πόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work two stitches as one purl stitch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo kaksi silmukkaa yhdeksi nurjaksi silmukaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter deux mailles en une seule maille envers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2目をまとめて1つの裏目にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 코를 함께 한 코의 안뜨기로 뜹니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk to masker sammen til én vrangmaske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee steken samen als één averechte steek breien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka två maskor tillsammans till en avig maska."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把两个针目一起织成一个上针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把兩個針目一起織成一個上針。"
          }
        }
      }
    },
    "stitchDictionary.p2tog.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet foran. Stik højre pind som til vrang gennem de næste to masker samtidig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden vorn. Die rechte Nadel wie zum Linksstricken gleichzeitig in die nächsten zwei Maschen stechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα μπροστά. Βάλτε τη δεξιά βελόνα στους επόμενους δύο πόντους μαζί, σαν για ανάποδη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep yarn in front. Insert the right needle purlwise through the next two loops together."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka edessä. Työnnä oikea puikko seuraaviin kahteen silmukkaan yhtä aikaa kuin neuloisit nurin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil devant. Piquer l’aiguille droite comme à l’envers dans les deux mailles suivantes ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を手前に置き、次の2目に右針を裏目の向きにまとめて入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 앞에 두고 오른바늘을 다음 두 코에 안뜨기 방향으로 한꺼번에 넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet foran. Stikk høyre pinne som til vrang gjennom de neste to maskene samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen voor. Steek de rechternaald averecht in de volgende twee lussen tegelijk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet framför. Stick höger sticka som för avigt genom nästa två maskor samtidigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于前方，右针以上针方向同时插入接下来两个线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於前方，右針以上針方向同時插入接下來兩個線圈。"
          }
        }
      }
    },
    "stitchDictionary.p2tog.accessibility.1": {
