    "stitchDictionary.purl.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå garnet om højre pind, og træk en ny løkke bagud gennem den gamle maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden um die rechte Nadel legen und eine neue Schlinge nach hinten durch die alte Masche ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τυλίξτε το νήμα και τραβήξτε μια νέα θηλιά προς τα πίσω μέσα από τον παλιό πόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap the yarn over the right needle and draw a new loop away from you through the old loop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä lanka oikean puikon ympäri ja vedä uusi lenkki vanhan silmukan läpi taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrouler le fil et tirer une nouvelle boucle vers l’arrière à travers l’ancienne maille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右針に糸をかけ、新しいループを元の目から向こう側へ引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른바늘에 실을 감고 새 고리를 원래 코 사이로 뒤쪽으로 빼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg garnet rundt høyre pinne og trekk en ny løkke bakover gjennom den gamle masken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla het garen om de rechternaald en trek een nieuwe lus naar achteren door de oude lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg garnet runt höger sticka och dra en ny ögla bakåt genom den gamla maskan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将线绕过右针，把新线圈穿过旧线圈往后拉出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將線繞過右針，把新線圈穿過舊線圈往後拉出。"
          }
        }
      }
    },
    "stitchDictionary.purl.accessibility.2": {
