          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Αφήστε τον παλιό πόντο να βγει από την αριστερή βελόνα· ο νέος μένει δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: Slide the old loop off the left needle; keep the new loop on the right."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Pudota vanha silmukka vasemmalta puikolta; uusi jää oikealle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Faire tomber l’ancienne maille de l’aiguille gauche ; garder la nouvelle à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：元の目を左針から外し、新しい目を右針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 원래 코를 왼바늘에서 빼고 새 코는 오른바늘에 남깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: La den gamle masken gli av venstre pinne; behold den nye på høyre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Laat de oude lus van de linkernaald glijden; de nieuwe blijft rechts."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Låt den gamla maskan glida av vänster sticka; behåll den nya på höger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：旧线圈滑离左针，新线圈留在右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：舊線圈滑離左針，新線圈留在右針。"
          }
        }
      }
    },
