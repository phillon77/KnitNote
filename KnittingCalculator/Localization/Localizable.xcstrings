    "stitchDictionary.centered-double-decrease.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Centreret dobbelt indtagning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentrierte doppelte Abnahme"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κεντρική διπλή μείωση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centered double decrease"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskitetty kaksoiskavennus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double diminution centrée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中上3目一度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중심 세 코 줄이기 (CDD, 설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentrert dobbel felling"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecentreerde dubbele mindering"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrerad dubbel minskning"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中上三针并一针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中上三針併一針"
          }
        }
      }
    },
    "stitchDictionary.centered-double-decrease.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducér tre masker til én med den midterste øverst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Maschen zu einer reduzieren, wobei die mittlere oben liegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μειώστε τρεις πόντους σε έναν με τον μεσαίο από πάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce three stitches to one with the center stitch on top."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavenna kolme silmukkaa yhdeksi niin, että keskimmäinen jää päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire trois mailles à une en gardant la maille centrale au-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3目を1目にし、中央の目を上に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 코를 한 코로 줄여 가운데 코가 위에 오게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fell tre masker til én med den midterste øverst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie steken tot één minderen met de middelste bovenop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska tre maskor till en med mittmaskan överst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三针减成一针，中间的针目位于上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三針減成一針，中間的針目位於上方。"
          }
        }
      }
    },
    "stitchDictionary.centered-double-decrease.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bagved. Tag to masker sammen løs af, som skulle de strikkes ret sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden hinten. Zwei Maschen gemeinsam wie zum Rechtszusammenstricken abheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα πίσω. Περάστε δύο πόντους μαζί άπλεκτους σαν να τους πλέκατε δύο μαζί καλή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With yarn behind, slip two stitches together as if knitting two together."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka takana. Nosta kaksi silmukkaa yhdessä kuin neuloisit ne oikein yhteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil derrière, glisser deux mailles ensemble comme pour les tricoter ensemble à l’endroit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、2目一度を編む向きに2目を一緒にすべらせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 두 코를 모아 겉뜨기하듯 한꺼번에 오른바늘에 옮깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bak. Ta to masker sammen løs av som om de skulle strikkes rett sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen achter. Haal twee steken samen af alsof je ze recht samenbreit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bakom. Lyft två maskor tillsammans som om de skulle stickas rätt tillsammans."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于后方，以下针两针并针的方向将两针一起滑到右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於後方，以下針兩針併針的方向將兩針一起滑到右針。"
          }
        }
      }
    },
    "stitchDictionary.centered-double-decrease.accessibility.1": {
