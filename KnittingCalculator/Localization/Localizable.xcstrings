    "stitchDictionary.cable-right-two.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-snoning mod højre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-Verkreuzung nach rechts"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλεξούδα 1/1 δεξιά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1 right cable"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-palmikko oikealle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croisement 1/1 à droite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上1目交差"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤에 한 코 두고 교차뜨기 (1/1 RC, 설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-flette mot høyre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-kabel naar rechts"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-fläta åt höger"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两针右交叉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩針右交叉"
          }
        }
      }
    },
    "stitchDictionary.cable-right-two.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryds to retmasker med den første bag arbejdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei rechte Maschen kreuzen; die erste wird hinten gehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταυρώστε δύο καλούς πόντους κρατώντας τον πρώτο πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross two knit stitches with the first held behind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Risti kaksi oikeaa silmukkaa pitäen ensimmäinen takana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croiser deux mailles endroit en gardant la première derrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の目を向こう側に休め、2つの表目を交差させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 코를 뒤에 두어 겉뜨기 두 코를 교차합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryss to rettmasker med den første bak arbeidet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee rechte steken kruisen met de eerste achter het werk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Korsa två räta maskor med den första bakom arbetet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一针暂放后方，将两个下针交叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一針暫放後方，將兩個下針交叉。"
          }
        }
      }
    },
    "stitchDictionary.cable-right-two.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag første maske vrang løs af på en hjælpepind, og hold den bag arbejdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Masche wie zum Linksstricken auf eine Zopfnadel heben und hinter der Arbeit halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περάστε τον πρώτο πόντο άπλεκτο σαν ανάποδη σε βοηθητική βελόνα και κρατήστε τον πίσω από το πλεκτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip the first stitch purlwise to a cable needle and hold it behind the fabric."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta ensimmäinen silmukka nurin neulomatta apupuikolle ja pidä se työn takana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser la première maille comme à l’envers sur une aiguille auxiliaire et la tenir derrière l’ouvrage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の1目を裏目の向きになわ編み針へ移し、編地の向こう側に置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 코를 안뜨기 방향으로 꽈배기바늘에 옮겨 편물 뒤에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta første maske løs av som vrang på en hjelpepinne og hold den bak arbeidet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal de eerste steek averecht af op een kabelnaald en houd die achter het werk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft första maskan som avig till en hjälpsticka och håll den bakom arbetet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上针方向滑第一针到麻花针，置于织片后方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上針方向滑第一針到麻花針，置於織片後方。"
          }
        }
      }
    },
