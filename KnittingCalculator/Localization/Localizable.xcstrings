    "calculator.home.gauge.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find stitch and row counts for your finished size."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算成品尺寸需要的針數與排數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算成品尺寸所需的针数和行数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermitteln Sie Maschen- und Reihenzahlen für die gewünschte Endgröße."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculez le nombre de mailles et de rangs pour les dimensions finales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕上がり寸法に必要な目数と段数を計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성 크기에 필요한 코 수와 단 수를 계산합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken het aantal steken en toeren voor de uiteindelijke afmetingen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn antall masker og rader for den ferdige størrelsen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beräkna antalet maskor och varv för den färdiga storleken."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske valmiin koon silmukka- ja kerrosmäärät."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregn maske- og rækketal til den færdige størrelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε τον αριθμό πόντων και σειρών για το τελικό μέγεθος."
          }
        }
      }
    },
    "calculator.home.adjustment.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space increases or decreases evenly in your knitting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平均安排編織中的加針或減針。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均匀安排编织中的加针或减针。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilen Sie Zunahmen oder Abnahmen gleichmäßig in Ihrem Strickstück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartissez régulièrement les augmentations ou diminutions dans votre tricot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編み地の増し目や減らし目を均等に配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨개질의 코 늘리기나 코 줄이기를 고르게 배치합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeel meerderingen of minderingen gelijkmatig over uw breiwerk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordel økninger eller fellinger jevnt i strikketøyet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fördela ökningar eller minskningar jämnt i stickningen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa lisäykset tai kavennukset tasaisesti neuleeseen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordel udtagninger eller indtagninger jævnt i strikketøjet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατανείμετε ομοιόμορφα τις αυξήσεις ή τις μειώσεις στο πλεκτό σας."
          }
        }
      }
    },
    "calculator.promotion.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need to manage projects, row counts, yarn, patterns, and a knitting journal? Meet KnitNote."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要管理作品、排數、毛線、織圖與編織日記？認識 KnitNote。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要管理作品、行数、毛线、图解和编织日志？认识 KnitNote。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie Projekte, Reihenzahlen, Garn, Muster und ein Stricktagebuch verwalten? Lernen Sie KnitNote kennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besoin de gérer vos projets, rangs, fils, patrons et votre journal de tricot ? Découvrez KnitNote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品、段数、毛糸、編み図、編み物日記を管理したいですか？KnitNoteをご紹介します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트, 단 수, 실, 도안과 뜨개 일지를 관리하고 싶으신가요? KnitNote를 만나 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u projecten, toerentellingen, garen, patronen en een breidagboek beheren? Maak kennis met KnitNote."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du administrere prosjekter, radtelling, garn, mønstre og en strikkedagbok? Bli kjent med KnitNote."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du hantera projekt, varvräkning, garn, mönster och en stickdagbok? Upptäck KnitNote."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko hallita projekteja, kerrosmääriä, lankoja, ohjeita ja neulepäiväkirjaa? Tutustu KnitNoteen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du administrere projekter, rækketælling, garn, opskrifter og en strikkedagbog? Mød KnitNote."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε να διαχειρίζεστε έργα, μετρήσεις σειρών, νήματα, σχέδια και ημερολόγιο πλεξίματος; Γνωρίστε το KnitNote."
          }
        }
      }
    },
    "calculator.promotion.product.relationship": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KnitNote is a separate app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
