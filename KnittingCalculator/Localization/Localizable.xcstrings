    "calculator.share.rowInterval.input.format" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ on %2$@ across %3$lld rows to adjust %4$lld stitches."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@（%2$@），分布在 %3$lld 排中，共調整 %4$lld 針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@（%2$@），分布在 %3$lld 行内，共调整 %4$lld 针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ auf %2$@ über %3$lld Reihen, um %4$lld Maschen anzupassen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ sur %2$@ pendant %3$lld rangs pour ajuster %4$lld mailles."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@を%2$@で%3$lld段にわたり行い、%4$lld目を調整します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%1$@를 %2$@에서 %3$lld단에 걸쳐 적용해 %4$lld코를 조정합니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ aan %2$@ over %3$lld toeren om %4$lld steken aan te passen."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ på %2$@ over %3$lld rader for å justere %4$lld masker."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ på %2$@ över %3$lld varv för att justera %4$lld maskor."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ %2$@ %3$lld kerroksen aikana, jotta %4$lld silmukkaa säädetään."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ i %2$@ over %3$lld rækker for at justere %4$lld masker."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "%1$@ σε %2$@ για %3$lld σειρές, ώστε να προσαρμοστούν %4$lld πόντοι."}}}},
    "calculator.share.rowInterval.result.format" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld adjustment events, %2$lld stitch per event. Interval: %3$@."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "共 %1$lld 次調整，每次 %2$lld 針。間隔：%3$@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "共 %1$lld 次调整，每次 %2$lld 针。间隔：%3$@。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld Anpassungsvorgänge, %2$lld Masche pro Vorgang. Abstand: %3$@."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld opérations d’ajustement, %2$lld maille par opération. Intervalle : %3$@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "調整は%1$lld回、1回あたり%2$lld目。間隔：%3$@。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "조정 %1$lld회, 회당 %2$lld코. 간격: %3$@."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld aanpassingen, %2$lld steek per aanpassing. Interval: %3$@."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld justeringer, %2$lld maske per justering. Intervall: %3$@."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld justeringar, %2$lld maska per justering. Intervall: %3$@."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld säätökertaa, %2$lld silmukka säätökertaa kohti. Väli: %3$@."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld justeringer, %2$lld maske pr. justering. Interval: %3$@."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "%1$lld ενέργειες προσαρμογής, %2$lld πόντος ανά ενέργεια. Διάστημα: %3$@."}}}},
