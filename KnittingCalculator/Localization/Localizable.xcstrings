    "calculator.promotion.action.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens KnitNote if it is installed, otherwise opens its App Store page."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝時開啟 KnitNote，否則開啟其 App Store 頁面。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已安装则打开 KnitNote，否则打开其 App Store 页面。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet KnitNote, wenn es installiert ist, andernfalls die zugehörige App-Store-Seite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre KnitNote si l’application est installée, sinon ouvre sa page dans l’App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KnitNoteがインストールされていれば開き、なければApp Storeのページを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KnitNote가 설치되어 있으면 열고, 없으면 App Store 페이지를 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent KnitNote als de app is geïnstalleerd, anders wordt de App Store-pagina geopend."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner KnitNote hvis appen er installert, ellers åpnes App Store-siden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar KnitNote om appen är installerad, annars öppnas dess App Store-sida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa KnitNoten, jos se on asennettu, tai muussa tapauksessa sen App Store -sivun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner KnitNote, hvis appen er installeret, ellers åbnes dens App Store-side."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει το KnitNote αν είναι εγκατεστημένο, διαφορετικά ανοίγει τη σελίδα του στο App Store."
          }
        }
      }
    },
