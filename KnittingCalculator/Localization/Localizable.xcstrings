    "stitchDictionary.yarn-over.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før garnet over højre pind og bagud, så der dannes én ny løkke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden über die rechte Nadel nach hinten legen, sodass eine neue Schlinge entsteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περάστε το νήμα πάνω από τη δεξιά βελόνα προς τα πίσω, σχηματίζοντας μία νέα θηλιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take yarn over the right needle to the back, making one new loop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie lanka oikean puikon yli taakse, jolloin syntyy yksi uusi lenkki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer le fil par-dessus l’aiguille droite vers l’arrière pour former une boucle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右針の上から糸を向こう側へ回し、ループを1つ作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 오른바늘 위로 넘겨 뒤에 두어 고리를 하나 만듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før garnet over høyre pinne og bakover, slik at det dannes én ny løkke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg het garen over de rechternaald naar achteren, zodat één nieuwe lus ontstaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För garnet över höger sticka och bakåt så att en ny ögla bildas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把线绕过右针上方移到后方，形成一个新线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把線繞過右針上方移到後方，形成一個新線圈。"
          }
        }
      }
    },
    "stitchDictionary.yarn-over.accessibility.2": {
