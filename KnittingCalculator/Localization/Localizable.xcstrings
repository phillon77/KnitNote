    "calculator.adjustment.rows.accessibility.summary.format" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld adjustment events, %3$lld stitches per event, %4$@."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。共 %2$lld 次調整，每次 %3$lld 針，%4$@。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。共 %2$lld 次调整，每次 %3$lld 针，%4$@。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld Anpassungsvorgänge, %3$lld Maschen pro Vorgang, %4$@."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld opérations d’ajustement, %3$lld mailles par opération, %4$@."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。調整は%2$lld回、1回あたり%3$lld目、%4$@。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. 조정 %2$lld회, 회당 %3$lld코, %4$@."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld aanpassingen, %3$lld steken per aanpassing, %4$@."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld justeringer, %3$lld masker per justering, %4$@."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld justeringar, %3$lld maskor per justering, %4$@."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld säätökertaa, %3$lld silmukkaa säätökertaa kohti, %4$@."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld justeringer, %3$lld masker pr. justering, %4$@."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$lld ενέργειες προσαρμογής, %3$lld πόντοι ανά ενέργεια, %4$@."}}}},
    "calculator.adjustment.rows.failure.invalidCounts" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter positive row and stitch counts."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入大於 0 的排數與針數。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入大于 0 的行数和针数。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Geben Sie positive Reihen- und Maschenzahlen ein."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Saisissez des nombres positifs de rangs et de mailles."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "0より大きい段数と目数を入力してください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "0보다 큰 단 수와 코 수를 입력하세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Voer positieve aantallen toeren en steken in."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Angi positive rad- og masketall."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Ange positiva varv- och maskantal."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Syötä positiiviset kerros- ja silmukkamäärät."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Indtast positive række- og masketal."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εισαγάγετε θετικούς αριθμούς σειρών και πόντων."}}}},
    "calculator.adjustment.rows.failure.exceedsSupportedLimit" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter a value of 100,000 or less."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入不超過 100,000 的數值。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入不超过 100,000 的数值。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Geben Sie einen Wert bis 100.000 ein."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Saisissez une valeur inférieure ou égale à 100 000."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "100,000以下の値を入力してください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "100,000 이하의 값을 입력하세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Voer een waarde van maximaal 100.000 in."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Angi en verdi på 100 000 eller mindre."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Ange ett värde på högst 100 000."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Syötä enintään 100 000."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Indtast en værdi på højst 100.000."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εισαγάγετε τιμή έως 100.000."}}}},
    "calculator.adjustment.rows.failure.symmetricRequiresEvenStitches" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Both-sides adjustment requires an even stitch count."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "雙側調整需要偶數針數。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "两侧调整要求针数为偶数。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Für die Anpassung auf beiden Seiten ist eine gerade Maschenzahl erforderlich."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "L’ajustement des deux côtés nécessite un nombre pair de mailles."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "両側を調整するには目数を偶数にしてください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "양쪽 조정에는 짝수 코 수가 필요합니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Voor aanpassing aan beide kanten is een even aantal steken nodig."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Justering på begge sider krever et partall masker."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Justering på båda sidor kräver ett jämnt maskantal."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Molempien puolien säätö vaatii parillisen silmukkamäärän."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Justering i begge sider kræver et lige antal masker."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Η προσαρμογή και στις δύο πλευρές απαιτεί άρτιο αριθμό πόντων."}}}},
    "calculator.adjustment.rows.failure.insufficientRows" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "There are not enough rows for this many adjustments."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "排數不足以安排這麼多次調整。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "行数不足，无法安排这么多次调整。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Für so viele Anpassungen sind nicht genügend Reihen vorhanden."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Il n’y a pas assez de rangs pour autant d’ajustements."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この回数を調整するには段数が足りません。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이만큼 조정하기에는 단 수가 부족합니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Er zijn niet genoeg toeren voor zoveel aanpassingen."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Det er ikke nok rader til så mange justeringer."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Det finns inte tillräckligt många varv för så många justeringar."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Kerrokset eivät riitä näin moneen säätöön."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Der er ikke nok rækker til så mange justeringer."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Δεν υπάρχουν αρκετές σειρές για τόσες προσαρμογές."}}}},
