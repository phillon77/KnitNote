    },
    "stitchDictionary.knit.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før garnet under og omkring højre pindspids."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden von unten um die rechte Nadelspitze legen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τυλίξτε το νήμα κάτω και γύρω από την άκρη της δεξιάς βελόνας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap the yarn under and over the right needle tip."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä lanka oikean puikon kärjen ali ja ympäri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrouler le fil sous puis autour de la pointe droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右針の先に糸を下から回しかけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 오른바늘 끝 아래에서 위로 감습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før garnet under og rundt høyre pinnespiss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla het garen onder en om de punt van de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För garnet under och runt höger stickspets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将工作线由右针下方绕过针尖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將工作線由右針下方繞過針尖。"
          }
        }
      }
    },
