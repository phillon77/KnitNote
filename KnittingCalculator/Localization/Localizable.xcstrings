    "stitchDictionary.slip-purlwise.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad den flyttede maske være ustrikket; der dannes ingen ny løkke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die übertragene Masche bleibt ungearbeitet; es entsteht keine neue Schlinge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πόντος μένει άπλεκτος· δεν δημιουργείται νέα θηλιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the transferred stitch unworked; no new loop is made."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä siirretty silmukka neulomatta; uutta lenkkiä ei synny."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser la maille transférée non tricotée ; aucune nouvelle boucle n’est créée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移した目は編まずに残します。新しいループは作りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮긴 코는 뜨지 않은 상태로 둡니다. 새 고리는 만들지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La den flyttede masken være ustrikket; det dannes ingen ny løkke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de overgezette steek ongebreid; er ontstaat geen nieuwe lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt den flyttade maskan vara ostickad; ingen ny ögla bildas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移过的线圈保持未编织；没有产生新线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移過的線圈保持未編織；沒有產生新線圈。"
          }
        }
      }
    },
