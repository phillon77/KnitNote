          "stringUnit": {
            "state": "translated",
            "value": "Strikkeberegner"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριθμομηχανή Πλεξίματος"
          }
        }
      }
    },
    "app.home.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to calculate?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天要計算什麼？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想计算什么？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchten Sie berechnen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous calculer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を計算しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 계산할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wilt u berekenen?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva vil du beregne?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad vill du beräkna?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä haluat laskea?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du beregne?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι θέλετε να υπολογίσετε;"
          }
        }
      }
    },
