    "stitchDictionary.k2tog.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To ret sammen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei rechts zusammenstricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο μαζί καλή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit two together"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi oikein yhteen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux mailles ensemble à l’endroit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上2目一度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코줄임 (K2TOG)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To rett sammen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee recht samenbreien"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två räta tillsammans"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下针两针并一针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下針兩針併一針"
          }
        }
      }
    },
    "stitchDictionary.k2tog.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik to masker til én, som hælder mod højre på retsiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Maschen zu einer rechts geneigten Masche auf der rechten Seite verbinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μειώστε δύο πόντους σε έναν με κλίση δεξιά στην καλή όψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce two stitches to one, leaning right on the knit side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavenna kaksi silmukkaa yhdeksi, joka kallistuu oikealla puolella oikealle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire deux mailles à une, inclinée à droite sur l’endroit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2目を1目にし、表目側から見ると右に傾きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 코를 한 코로 줄이며 겉면에서 오른쪽으로 기웁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fell to masker til én som heller mot høyre på rettsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee steken tot één minderen, rechtshellend aan de rechte kant."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska två maskor till en som lutar åt höger på rätsidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将两针并成一针，在下针面呈右倾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將兩針併成一針，在下針面呈右傾。"
          }
        }
      }
    },
    "stitchDictionary.k2tog.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bagved. Stik højre pind gennem de forreste lænker på de næste to masker samtidig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden hinten. Die rechte Nadel gleichzeitig durch die vorderen Glieder der nächsten zwei Maschen stechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα πίσω. Βάλτε τη δεξιά βελόνα στα μπροστινά σκέλη των επόμενων δύο πόντων μαζί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep yarn behind. Insert the right needle through the fronts of the next two loops together."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka takana. Työnnä oikea puikko seuraavien kahden silmukan etureunoihin yhtä aikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil derrière. Piquer l’aiguille droite dans les brins avant des deux mailles suivantes ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、次の2目の手前側に右針をまとめて入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 오른바늘을 다음 두 코의 앞쪽에 한꺼번에 넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bak. Stikk høyre pinne gjennom fremre ledd i de neste to maskene samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen achter. Steek de rechternaald samen door de voorste lussen van de volgende twee steken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bakom. Stick höger sticka genom de främre bågarna på nästa två maskor samtidigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于后方，右针同时插入接下来两个线圈的前半针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於後方，右針同時插入接下來兩個線圈的前半針。"
          }
        }
      }
    },
    "stitchDictionary.k2tog.accessibility.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet bagved. Stik højre pind gennem de forreste lænker på de næste to masker samtidig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnung: Faden hinten. Die rechte Nadel gleichzeitig durch die vorderen Glieder der nächsten zwei Maschen stechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Νήμα πίσω. Βάλτε τη δεξιά βελόνα στα μπροστινά σκέλη των επόμενων δύο πόντων μαζί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: Keep yarn behind. Insert the right needle through the fronts of the next two loops together."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Lanka takana. Työnnä oikea puikko seuraavien kahden silmukan etureunoihin yhtä aikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Fil derrière. Piquer l’aiguille droite dans les brins avant des deux mailles suivantes ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：糸を向こう側に置き、次の2目の手前側に右針をまとめて入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 실을 뒤에 두고 오른바늘을 다음 두 코의 앞쪽에 한꺼번에 넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet bak. Stikk høyre pinne gjennom fremre ledd i de neste to maskene samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Garen achter. Steek de rechternaald samen door de voorste lussen van de volgende twee steken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Garnet bakom. Stick höger sticka genom de främre bågarna på nästa två maskor samtidigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：线置于后方，右针同时插入接下来两个线圈的前半针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：線置於後方，右針同時插入接下來兩個線圈的前半針。"
          }
        }
      }
    },
    "stitchDictionary.k2tog.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå garnet om, og træk én ny løkke gennem begge gamle masker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden umlegen und eine neue Schlinge durch beide alten Maschen ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τυλίξτε το νήμα και τραβήξτε μία νέα θηλιά μέσα από τους δύο παλιούς πόντους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap yarn and pull one new loop through both old loops."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä lanka ja vedä yksi uusi lenkki molempien vanhojen silmukoiden läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrouler le fil et tirer une nouvelle boucle à travers les deux anciennes mailles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸をかけ、2つの元のループから新しいループを1つ引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 감고 두 코 사이로 새 고리 하나를 빼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg garnet rundt og trekk én ny løkke gjennom begge gamle masker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla het garen om en trek één nieuwe lus door beide oude lussen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg garnet runt och dra en ny ögla genom båda gamla maskorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕线，从两个旧线圈中拉出一个新线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繞線，從兩個舊線圈中拉出一個新線圈。"
          }
        }
      }
    },
