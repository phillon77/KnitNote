    "calculator.adjustment.failure.cannotPreserveEdges": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These counts cannot reserve one stitch at each edge. Turn off edge stitches or change the counts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這組針數無法左右各保留 1 針，請關閉邊針或調整針數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这组针数无法在两侧各保留 1 针。请关闭边针选项或更改针数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesen Zahlen kann nicht an jeder Seite eine Randmasche bleiben. Deaktivieren Sie die Randmaschen oder ändern Sie die Zahlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces nombres ne permettent pas de réserver une maille lisière de chaque côté. Désactivez les lisières ou modifiez les nombres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この目数では左右に端目を1目ずつ残せません。端目をオフにするか、目数を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코 수로는 양쪽에 가장자리 코를 1코씩 남길 수 없습니다. 가장자리 코를 끄거나 코 수를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij deze aantallen kan niet aan elke kant één kantsteek worden behouden. Schakel kantsteken uit of wijzig de aantallen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse tallene tillater ikke én kantmaske på hver side. Slå av kantmasker eller endre tallene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här antalen kan inte behålla en kantmaska på varje sida. Stäng av kantmaskor eller ändra antalen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näillä määrillä ei voi jättää yhtä reunasilmukkaa kummallekin puolelle. Poista reunasilmukat käytöstä tai muuta määriä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse tal kan ikke bevare én kantmaske i hver side. Slå kantmasker fra, eller skift tallene."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτούς τους αριθμούς δεν μπορεί να διατηρηθεί ένας ακριανός πόντος σε κάθε πλευρά. Απενεργοποιήστε τους ακριανούς πόντους ή αλλάξτε τους αριθμούς."
          }
        }
      }
    },
    "calculator.adjustment.failure.requiresMultipleRows": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This adjustment cannot fit in one row. Use Across Rows."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次調整無法在單行完成，請改用跨排。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此调整无法在一行内完成。请使用跨行调整。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anpassung passt nicht in eine Reihe. Verwenden Sie „Über mehrere Reihen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ajustement ne tient pas sur un seul rang. Utilisez « Sur plusieurs rangs »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この調整は1段に収まりません。「複数段」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조정은 한 단에 배치할 수 없습니다. ‘여러 단’을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze aanpassing past niet in één toer. Gebruik ‘Over meerdere toeren’."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne justeringen får ikke plass på én rad. Bruk «Over flere rader»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här justeringen får inte plats på ett varv. Använd ”Över flera varv”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä säätö ei mahdu yhdelle kerrokselle. Käytä vaihtoehtoa ”Usealle kerrokselle”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne justering kan ikke være på én række. Brug “Over flere rækker”."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η προσαρμογή δεν χωρά σε μία σειρά. Χρησιμοποιήστε την επιλογή «Σε πολλές σειρές»."
          }
        }
      }
    },
