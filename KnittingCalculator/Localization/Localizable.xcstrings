    "calculator.settings.reset.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears calculator inputs while keeping your unit and app counters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除計算器輸入，但保留單位與 App 計數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除计算器输入，同时保留单位和应用计数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Rechnereingaben, behält aber Einheit und App-Zähler bei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les saisies du calculateur tout en conservant l’unité et les compteurs de l’application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算機の入力を消去しますが、単位とアプリのカウントは保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산기 입력을 지우되 단위와 앱 횟수는 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist de invoer van de calculator, maar behoudt uw eenheid en app-tellers."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner inndata i kalkulatoren, men beholder enhet og app-tellere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensar kalkylatorns inmatningar men behåller enhet och appens räknare."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjentää laskurin syötteet mutta säilyttää yksikön ja sovelluksen laskurit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydder beregnerens indtastninger, men bevarer enhed og appens tællere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει τις τιμές της αριθμομηχανής, διατηρώντας τη μονάδα και τους μετρητές της εφαρμογής."
          }
        }
      }
    },
