    },
    "stitchDictionary.p2tog.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad begge gamle masker glide af sammen. Én vrangmaske er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide alten Maschen zusammen abgleiten lassen. Eine linke Masche bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε και τους δύο παλιούς πόντους μαζί. Μένει ένας ανάποδος πόντος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release both old loops together. One purl stitch remains."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota molemmat vanhat silmukat yhdessä. Yksi nurja silmukka jää jäljelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser tomber les deux anciennes mailles ensemble. Il reste une maille envers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の2目を一緒に外します。裏目が1目残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 두 코를 함께 빼면 안뜨기 한 코가 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La begge gamle masker gli av sammen. Én vrangmaske er igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat beide oude lussen tegelijk los. Er blijft één averechte steek over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt båda gamla maskorna glida av tillsammans. En avig maska återstår."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个旧线圈一起滑离左针，留下一个上针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個舊線圈一起滑離左針，留下一個上針。"
          }
        }
      }
    },
