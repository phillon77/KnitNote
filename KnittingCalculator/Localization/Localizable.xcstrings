    "calculator.adjustment.summary.decrease.format" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Decrease %lld stitches evenly."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "平均減少 %lld 針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "均匀减 %lld 针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "%lld Maschen gleichmäßig abnehmen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Diminuer régulièrement de %lld mailles."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%lld目を均等に減らします。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%lld코를 고르게 줄입니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Minder %lld steken gelijkmatig."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Fell jevnt %lld masker."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Minska jämnt med %lld maskor."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Kavenna %lld silmukkaa tasaisesti."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Tag %lld masker jævnt ind."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Μειώστε ομοιόμορφα κατά %lld πόντους."}}}},
    "calculator.adjustment.edgeSummary.reserved" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "One edge stitch is reserved on each side."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "左右各保留 1 針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "两侧各保留 1 针边针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Auf jeder Seite bleibt eine Randmasche stehen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Une maille lisière est réservée de chaque côté."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "左右に端目を1目ずつ残します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "양쪽에 가장자리 코 1코씩을 남깁니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Aan elke kant wordt één kantsteek behouden."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Én kantmaske beholdes på hver side."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "En kantmaska behålls på varje sida."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Kummallekin puolelle jätetään yksi reunasilmukka."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Der bevares én kantmaske i hver side."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Διατηρείται ένας ακριανός πόντος σε κάθε πλευρά."}}}},
    "calculator.adjustment.edgeSummary.notReserved" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No edge stitches are reserved."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "未保留邊針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不保留边针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Es bleiben keine Randmaschen stehen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Aucune maille lisière n’est réservée."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "端目は残しません。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "가장자리 코를 남기지 않습니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Er worden geen kantsteken behouden."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Ingen kantmasker beholdes."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Inga kantmaskor behålls."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Reunasilmukoita ei jätetä."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Der bevares ingen kantmasker."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Δεν διατηρούνται ακριανοί πόντοι."}}}},
