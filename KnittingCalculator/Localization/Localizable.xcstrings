    "stitchDictionary.centered-double-decrease.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik næste maske ret; behold de to løse masker på højre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Masche rechts stricken; die beiden abgehobenen Maschen bleiben rechts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε τον επόμενο πόντο καλή· οι δύο άπλεκτοι μένουν δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit the next stitch normally, leaving the two slipped stitches on the right needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo seuraava silmukka oikein; nostetut kaksi jäävät oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter la maille suivante à l’endroit ; les deux mailles glissées restent à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の1目を表編みします。すべらせた2目は右針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 한 코를 겉뜨기합니다. 옮겨둔 두 코는 오른바늘에 남깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk neste maske rett; behold de to løse maskene på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei de volgende steek recht; laat de twee afgehaalde steken op de rechternaald staan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka nästa maska rätt; behåll de två lyfta maskorna på höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一针正常织下针，两个滑针仍留在右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一針正常織下針，兩個滑針仍留在右針。"
          }
        }
      }
    },
    "stitchDictionary.centered-double-decrease.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Strik næste maske ret; behold de to løse masker på højre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnung: Die nächste Masche rechts stricken; die beiden abgehobenen Maschen bleiben rechts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Πλέξτε τον επόμενο πόντο καλή· οι δύο άπλεκτοι μένουν δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: Knit the next stitch normally, leaving the two slipped stitches on the right needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Neulo seuraava silmukka oikein; nostetut kaksi jäävät oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Tricoter la maille suivante à l’endroit ; les deux mailles glissées restent à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：次の1目を表編みします。すべらせた2目は右針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 다음 한 코를 겉뜨기합니다. 옮겨둔 두 코는 오른바늘에 남깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Strikk neste maske rett; behold de to løse maskene på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Brei de volgende steek recht; laat de twee afgehaalde steken op de rechternaald staan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Sticka nästa maska rätt; behåll de två lyfta maskorna på höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：下一针正常织下针，两个滑针仍留在右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：下一針正常織下針，兩個滑針仍留在右針。"
          }
        }
      }
    },
    "stitchDictionary.centered-double-decrease.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft begge løse masker sammen over den nye maske og af spidsen; tre bliver til én."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide abgehobenen Maschen gemeinsam über die neue Masche und von der Spitze heben; aus drei wird eine."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σηκώστε και τους δύο άπλεκτους μαζί πάνω από τον νέο πόντο και έξω από την άκρη· οι τρεις γίνονται ένας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift both slipped stitches together over the new stitch and off the tip; three stitches become one."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta molemmat nostetut silmukat yhdessä uuden silmukan yli ja pois kärjestä; kolmesta tulee yksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer les deux mailles glissées ensemble par-dessus la nouvelle maille et hors de la pointe ; trois deviennent une."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべり目2目を一緒に持ち上げ、新しい目にかぶせて外します。3目が1目になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮겨둔 두 코를 함께 들어 새 코 위로 넘겨 뺍니다. 세 코가 한 코가 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft begge løse masker sammen over den nye masken og av spissen; tre blir til én."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Til beide afgehaalde steken samen over de nieuwe steek en van de punt af; drie worden één."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft båda lyfta maskorna tillsammans över den nya maskan och av spetsen; tre blir en."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把两个滑针一起挑起，套过新针目并移出针尖；三针成一针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把兩個滑針一起挑起，套過新針目並移出針尖；三針成一針。"
          }
        }
      }
    },
