        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 계산기 입력만 지웁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt alleen de op dit apparaat bewaarde invoer van de calculator gewist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner bare kalkulatorinndata som er lagret på denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta rensar endast kalkylatorinmatningar som sparats på den här enheten."
