    "stitchDictionary.make-one-left.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstrehældende udtagning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links geneigte Zunahme"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αύξηση με κλίση αριστερά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one left"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasemmalle kallistuva lisäys"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentation intercalaire gauche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左傾斜のねじり増し目（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼코 늘리기-겉뜨기 (M1L)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstrevendt økning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkshellend meerderen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänsterlutande ökning"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左倾扭加针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左傾扭加針"
          }
        }
      }
    },
    "stitchDictionary.make-one-left.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej lænken mellem maskerne, og tilføj én venstrehældende maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Querfaden verdrehen und eine links geneigte Masche hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρίψτε το νήμα ανάμεσα σε πόντους για μία αύξηση με κλίση αριστερά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twist the strand between stitches to add one left-leaning stitch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä silmukoiden välinen lanka yhdeksi vasemmalle kallistuvaksi lisäsilmukaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tordre le fil entre les mailles pour ajouter une maille inclinée à gauche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡り糸をねじって、左に傾く目を1目増やします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코 사이의 가로실을 꼬아 왼쪽으로 기우는 코를 하나 늘립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri tråden mellom maskene og legg til én venstrevendt maske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De draad tussen steken verdraaien voor één linkshellende steek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid tråden mellan maskorna och lägg till en vänsterlutande maska."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起针间横线扭织，增加一个左倾针目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起針間橫線扭織，增加一個左傾針目。"
          }
        }
      }
    },
    "stitchDictionary.make-one-left.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft lænken mellem maskerne med venstre pind forfra og bagud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Querfaden zwischen den Maschen mit der linken Nadel von vorn nach hinten aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σηκώστε το ενδιάμεσο νήμα με την αριστερή βελόνα από εμπρός προς τα πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the left needle, lift the strand between stitches from front to back."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta silmukoiden välinen lanka vasemmalla puikolla edestä taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’aiguille gauche, relever le fil entre les mailles de l’avant vers l’arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目と目の間の渡り糸を、左針で手前から向こうへすくいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼바늘로 코 사이의 가로실을 앞에서 뒤로 들어 올립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft tråden mellom maskene med venstre pinne forfra og bakover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem met de linkernaald de tussendraad van voren naar achteren op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft tråden mellan maskorna med vänster sticka framifrån och bakåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用左针由前往后挑起两针之间的横线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用左針由前往後挑起兩針之間的橫線。"
          }
        }
      }
    },
    "stitchDictionary.make-one-left.accessibility.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Løft lænken mellem maskerne med venstre pind forfra og bagud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnung: Den Querfaden zwischen den Maschen mit der linken Nadel von vorn nach hinten aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Σηκώστε το ενδιάμεσο νήμα με την αριστερή βελόνα από εμπρός προς τα πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: With the left needle, lift the strand between stitches from front to back."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Nosta silmukoiden välinen lanka vasemmalla puikolla edestä taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Avec l’aiguille gauche, relever le fil entre les mailles de l’avant vers l’arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：目と目の間の渡り糸を、左針で手前から向こうへすくいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 왼바늘로 코 사이의 가로실을 앞에서 뒤로 들어 올립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Løft tråden mellom maskene med venstre pinne forfra og bakover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Neem met de linkernaald de tussendraad van voren naar achteren op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Lyft tråden mellan maskorna med vänster sticka framifrån och bakåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：用左针由前往后挑起两针之间的横线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：用左針由前往後挑起兩針之間的橫線。"
          }
        }
      }
    },
    "stitchDictionary.make-one-left.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik ret i den løftede løkkes bagerste lænke, så løkken drejes og hullet lukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aufgenommenen Faden durch das hintere Glied rechts stricken; die Drehung schließt das Loch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε καλή στο πίσω σκέλος της σηκωμένης θηλιάς, στρίβοντάς την ώστε να κλείσει η τρύπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit into the back leg of the lifted strand, twisting it closed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo nostetun lenkin takareunasta oikein, jolloin lenkki kiertyy ja reikä sulkeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter le brin arrière à l’endroit pour tordre la boucle et fermer le trou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すくったループの向こう側を表編みし、ねじって穴を閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어 올린 고리의 뒤쪽을 겉뜨기해 실이 꼬여 구멍이 닫히게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk rett i bakre ledd av den løftede løkken, slik at den vris og hullet lukkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei recht door de achterste lus om de draad te verdraaien en het gaatje te sluiten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka rätt i den lyfta öglans bakre båge så att öglan vrids och hålet stängs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织挑起线圈的后半针，使横线扭转闭合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織挑起線圈的後半針，使橫線扭轉閉合。"
          }
        }
      }
    },
    "stitchDictionary.make-one-left.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
