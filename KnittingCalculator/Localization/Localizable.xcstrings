          }
        }
      }
    },
    "stitchDictionary.knit.step.4": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad den gamle maske glide af venstre pind; behold den nye på højre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Masche von der linken Nadel gleiten lassen; die neue bleibt rechts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τον παλιό πόντο να βγει από την αριστερή βελόνα· ο νέος μένει δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide the old loop off the left needle; keep the new loop on the right."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota vanha silmukka vasemmalta puikolta; uusi jää oikealle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire tomber l’ancienne maille de l’aiguille gauche ; garder la nouvelle à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の目を左針から外し、新しい目を右針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 코를 왼바늘에서 빼고 새 코는 오른바늘에 남깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La den gamle masken gli av venstre pinne; behold den nye på høyre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de oude lus van de linkernaald glijden; de nieuwe blijft rechts."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt den gamla maskan glida av vänster sticka; behåll den nya på höger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧线圈滑离左针，新线圈留在右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊線圈滑離左針，新線圈留在右針。"
          }
        }
      }
    },
    "stitchDictionary.knit.accessibility.4": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
