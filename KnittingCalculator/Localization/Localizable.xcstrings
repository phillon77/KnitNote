    "calculator.help.gauge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure a swatch, enter its size and stitch count, then enter your target size. Example: 20 stitches across 10 cm becomes 80 stitches across 40 cm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "量好試片後輸入尺寸與針數，再輸入目標尺寸。例如：10 公分 20 針，40 公分建議 80 針。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量小样，输入其尺寸和针数，再输入目标尺寸。例如：10 厘米 20 针，40 厘米需要 80 针。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messen Sie eine Maschenprobe, geben Sie Größe und Maschenzahl ein und anschließend die Zielgröße. Beispiel: 20 Maschen auf 10 cm ergeben 80 Maschen auf 40 cm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez un échantillon, saisissez ses dimensions et son nombre de mailles, puis la dimension souhaitée. Exemple : 20 mailles sur 10 cm donnent 80 mailles sur 40 cm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワッチを測り、寸法と目数、続いて目標寸法を入力します。例：10 cmで20目なら、40 cmでは80目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와치를 측정하고 크기와 코 수를 입력한 다음 목표 크기를 입력하세요. 예: 10cm에 20코라면 40cm에는 80코입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet een proeflap, voer de afmetingen en het aantal steken in en voer daarna de gewenste afmeting in. Voorbeeld: 20 steken per 10 cm worden 80 steken per 40 cm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål en strikkeprøve, angi størrelsen og antall masker, og angi deretter målstørrelsen. Eksempel: 20 masker på 10 cm blir 80 masker på 40 cm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mät ett stickprov, ange dess storlek och antal maskor och ange sedan målstorleken. Exempel: 20 maskor på 10 cm blir 80 maskor på 40 cm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaa mallitilkku, syötä sen koko ja silmukkamäärä ja sitten tavoitekoko. Esimerkki: 20 silmukkaa 10 cm:llä tarkoittaa 80 silmukkaa 40 cm:llä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål en strikkeprøve, indtast størrelse og masketal, og indtast derefter målstørrelsen. Eksempel: 20 masker på 10 cm bliver 80 masker på 40 cm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρήστε ένα δείγμα, εισαγάγετε τις διαστάσεις και τους πόντους του και έπειτα το επιθυμητό μέγεθος. Παράδειγμα: 20 πόντοι σε 10 cm γίνονται 80 πόντοι σε 40 cm."
          }
        }
      }
    },
    "calculator.help.adjustment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the current and target stitch counts for one row, or spread a total adjustment across rows. Example: increasing from 80 to 90 adds 10 stitches evenly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單行可輸入目前與目標針數，也可把總調整分配到多排。例如：80 針增加到 90 針，會平均安排 10 次加針。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入单行的当前和目标针数，或将总调整分配到多行。例如：从 80 针增加到 90 针，会均匀加 10 针。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie aktuelle und gewünschte Maschenzahl für eine Reihe ein oder verteilen Sie die gesamte Anpassung über mehrere Reihen. Beispiel: Von 80 auf 90 werden 10 Maschen gleichmäßig zugenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le nombre actuel et souhaité de mailles pour un rang, ou répartissez l’ajustement sur plusieurs rangs. Exemple : passer de 80 à 90 ajoute régulièrement 10 mailles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1段の現在と目標の目数を入力するか、全体の調整を複数段に分けます。例：80目から90目にする場合、10目を均等に増やします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 단의 현재 코 수와 목표 코 수를 입력하거나 전체 조정을 여러 단에 나누세요. 예: 80코에서 90코로 늘리면 10코를 고르게 늘립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer voor één toer het huidige en gewenste aantal steken in of verdeel de totale aanpassing over meerdere toeren. Voorbeeld: van 80 naar 90 voegt gelijkmatig 10 steken toe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi gjeldende og ønsket masketall for én rad, eller fordel hele justeringen over flere rader. Eksempel: Fra 80 til 90 økes det jevnt med 10 masker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange aktuellt och önskat maskantal för ett varv, eller fördela hela justeringen över flera varv. Exempel: från 80 till 90 ökar jämnt med 10 maskor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä yhden kerroksen nykyinen ja tavoiteltu silmukkamäärä tai jaa koko muutos usealle kerrokselle. Esimerkki: 80 silmukasta 90:een lisätään tasaisesti 10 silmukkaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast det aktuelle og ønskede masketal for én række, eller fordel den samlede justering over flere rækker. Eksempel: Fra 80 til 90 tages 10 masker jævnt ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τους τρέχοντες και επιθυμητούς πόντους για μία σειρά ή κατανείμετε τη συνολική προσαρμογή σε πολλές σειρές. Παράδειγμα: από 80 σε 90 προστίθενται ομοιόμορφα 10 πόντοι."
          }
        }
      }
    },
