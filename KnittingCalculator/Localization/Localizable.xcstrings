    "stitchDictionary.skp.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft med venstre pind den løse maske over den nye retmaske og af højre pindspids."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der linken Nadel die abgehobene Masche über die neue rechte Masche und von der Nadelspitze heben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την αριστερή βελόνα σηκώστε τον άπλεκτο πάνω από τον νέο καλό πόντο και έξω από τη δεξιά άκρη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the left needle to lift the slipped stitch over the new knit stitch and off the right tip."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta vasemmalla puikolla neulomaton silmukka uuden oikean silmukan yli ja pois oikean puikon kärjestä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’aiguille gauche, passer la maille glissée par-dessus la nouvelle maille et hors de la pointe droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左針ですべり目を持ち上げ、新しく編んだ目にかぶせて右針から外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼바늘로 걸러둔 코를 들어 새로 뜬 코 위로 넘기고 오른바늘 끝에서 뺍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft den løse masken med venstre pinne over den nye rettmasken og av høyre pinnespiss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Til met de linkernaald de afgehaalde steek over de nieuwe rechte steek en van de rechterpunt af."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft den lyfta maskan med vänster sticka över den nya räta maskan och av höger spets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用左针挑起滑针，套过新织的下针并移出右针尖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用左針挑起滑針，套過新織的下針並移出右針尖。"
          }
        }
      }
    },
    "stitchDictionary.skp.accessibility.3": {
