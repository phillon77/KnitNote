    "stitchDictionary.knit.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk den nye løkke frem gennem den gamle maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Schlinge nach vorn durch die alte Masche ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε τη νέα θηλιά προς τα εμπρός μέσα από τον παλιό πόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the new loop forward through the old loop."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä uusi lenkki vanhan silmukan läpi eteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer la nouvelle boucle vers l’avant à travers l’ancienne maille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいループを元の目から手前へ引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 고리를 원래 코 사이로 앞쪽으로 빼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk den nye løkken frem gjennom den gamle masken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek de nieuwe lus naar voren door de oude lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra den nya öglan framåt genom den gamla maskan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把新线圈往前拉出旧线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把新線圈往前拉出舊線圈。"
          }
        }
      }
    },
    "stitchDictionary.knit.accessibility.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
