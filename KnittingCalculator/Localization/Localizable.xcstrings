    "calculator.settings.reset.confirmation.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears only the calculator inputs saved on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清除儲存在此裝置上的計算器輸入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会清除此设备上保存的计算器输入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden nur die auf diesem Gerät gespeicherten Rechnereingaben gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les saisies du calculateur enregistrées sur cet appareil seront effacées."
