          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Lanka takana. Nosta yksi silmukka oikein neulomatta oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Fil derrière, glisser une maille comme à l’endroit sur l’aiguille droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：糸を向こう側に置き、1目を表目の向きに右針へすべらせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 실을 뒤에 두고 한 코를 겉뜨기 방향으로 오른바늘에 옮깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet bak. Ta én maske løs av som rett på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Garen achter. Haal één steek recht af op de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Garnet bakom. Lyft en maska som en rät till höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：线置于后方，以下针方向滑一针到右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：線置於後方，以下針方向滑一針到右針。"
          }
        }
      }
    },
    "stitchDictionary.skp.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik næste maske ret; den løse maske bliver ved siden af på højre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Masche rechts stricken; die abgehobene Masche bleibt daneben auf der rechten Nadel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε τον επόμενο πόντο καλή· ο άπλεκτος μένει δίπλα του στη δεξιά βελόνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit the next stitch normally; the slipped stitch stays beside it on the right needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo seuraava silmukka oikein; nostettu silmukka jää sen viereen oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter la maille suivante à l’endroit ; laisser la maille glissée à côté sur l’aiguille droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の1目を表編みします。すべり目は右針に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 코를 겉뜨기합니다. 걸러둔 코는 오른바늘에 그대로 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk neste maske rett; den løse masken blir ved siden av på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei de volgende steek recht; de afgehaalde steek blijft ernaast op de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka nästa maska rätt; den lyfta maskan ligger kvar bredvid på höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一针织下针；先前滑针留在右针旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一針織下針；先前滑針留在右針旁邊。"
          }
        }
      }
    },
    "stitchDictionary.skp.accessibility.2": {
