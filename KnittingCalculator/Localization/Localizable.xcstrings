{
  "sourceLanguage" : "en",
  "strings" : {
    "app.home.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "What would you like to calculate?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "今天要計算什麼？" } } } },
