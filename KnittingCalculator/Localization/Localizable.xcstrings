          }
        }
      }
    },
    "stitchDictionary.skp.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs af, ret, træk over"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abheben, rechts stricken, überziehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άπλεκτος, καλή, πέρασμα από πάνω"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip, knit, pass over"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta, neulo, vedä yli"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surjet simple"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上2目一度（かぶせる方法）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸러뜨고 겉뜨고 덮어씌우기 (SKP, 설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs av, rett, trekk over"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhalen, recht, overhalen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft, rätt, dra över"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑针、下针、套收"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑針、下針、套收"
          }
        }
      }
    },
    "stitchDictionary.skp.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstrehældende indtagning ved at trække en løs maske over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links geneigte Abnahme durch Überziehen einer abgehobenen Masche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείωση με κλίση αριστερά περνώντας έναν άπλεκτο πόντο από πάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A left-leaning decrease made by passing a slipped stitch over."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasemmalle kallistuva kavennus nostetun silmukan ylivetämisellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminution inclinée à gauche en rabattant une maille glissée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべり目を編んだ目にかぶせる、左傾斜の減目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸러둔 코를 새 코 위로 넘겨 왼쪽으로 줄입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstrevendt felling ved å trekke en løs maske over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkshellende mindering door een afgehaalde steek over te halen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänsterlutande minskning genom att dra en lyft maska över."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把滑针套过新织针目，形成左倾减针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把滑針套過新織針目，形成左傾減針。"
          }
        }
      }
    },
    "stitchDictionary.skp.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bagved. Tag én maske ret løs af på højre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden hinten. Eine Masche wie zum Rechtsstricken rechts abheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα πίσω. Περάστε έναν πόντο άπλεκτο σαν καλή στη δεξιά βελόνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With yarn behind, slip one stitch knitwise onto the right needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka takana. Nosta yksi silmukka oikein neulomatta oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil derrière, glisser une maille comme à l’endroit sur l’aiguille droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、1目を表目の向きに右針へすべらせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 한 코를 겉뜨기 방향으로 오른바늘에 옮깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bak. Ta én maske løs av som rett på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen achter. Haal één steek recht af op de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bakom. Lyft en maska som en rät till höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于后方，以下针方向滑一针到右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於後方，以下針方向滑一針到右針。"
          }
        }
      }
    },
    "stitchDictionary.skp.accessibility.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
