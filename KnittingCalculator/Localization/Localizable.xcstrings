    "stitchDictionary.knit.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En grundmaske med et V på retsiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Grundmasche mit einem V auf der rechten Seite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βασικός πόντος που σχηματίζει V στην καλή όψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A basic stitch with a V on the knit side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perussilmukka, joka muodostaa V-kuvion oikealle puolelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une maille de base formant un V sur l’endroit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表側に V 字が見える基本の編み方です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉면에 V 모양이 생기는 기본 뜨기입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En grunnmaske med en V på rettsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een basissteek met een V aan de rechte kant."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En grundmaska med ett V på rätsidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织出正面呈 V 字形的基本针法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織出正面呈 V 字形的基本針法。"
          }
        }
      }
    },
    "stitchDictionary.knit.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold garnet bag arbejdet. Stik højre pind ind i første maske forfra og bagud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden hinter die Arbeit legen. Die rechte Nadel von vorn nach hinten in die erste Masche einstechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το νήμα πίσω. Βάλτε τη δεξιά βελόνα στον πρώτο πόντο από εμπρός προς τα πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep yarn behind. Insert the right needle into the first loop from front to back."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä lanka takana. Työnnä oikea puikko ensimmäiseen silmukkaan edestä taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer le fil derrière. Piquer l’aiguille droite dans la première maille, de l’avant vers l’arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、右針を最初の目に手前から向こうへ入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 오른바늘을 첫 코에 앞에서 뒤로 넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold garnet bak arbeidet. Stikk høyre pinne inn i første maske forfra og bakover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd het garen achter. Steek de rechternaald van voren naar achteren in de eerste lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll garnet bakom arbetet. Stick höger sticka genom första maskan framifrån och bakåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作线置于后方，右针由前往后插入左针第一个线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作線置於後方，右針由前往後插入左針第一個線圈。"
          }
        }
      }
    },
