    "stitchDictionary.cable-left-two.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-snoning mod venstre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-Verkreuzung nach links"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλεξούδα 1/1 αριστερά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1 left cable"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-palmikko vasemmalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croisement 1/1 à gauche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上1目交差"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 한 코 두고 교차뜨기 (1/1 LC, 설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-flette mot venstre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-kabel naar links"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1/1-fläta åt vänster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两针左交叉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩針左交叉"
          }
        }
      }
    },
    "stitchDictionary.cable-left-two.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryds to retmasker med den første foran arbejdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei rechte Maschen kreuzen; die erste wird vorn gehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταυρώστε δύο καλούς πόντους κρατώντας τον πρώτο μπροστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross two knit stitches with the first held in front."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Risti kaksi oikeaa silmukkaa pitäen ensimmäinen edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croiser deux mailles endroit en gardant la première devant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の目を手前に休め、2つの表目を交差させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 코를 앞에 두어 겉뜨기 두 코를 교차합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryss to rettmasker med den første foran arbeidet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee rechte steken kruisen met de eerste voor het werk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Korsa två räta maskor med den första framför arbetet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一针暂放前方，将两个下针交叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一針暫放前方，將兩個下針交叉。"
          }
        }
      }
    },
    "stitchDictionary.cable-left-two.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag første maske vrang løs af på en hjælpepind, og hold den foran arbejdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Masche wie zum Linksstricken auf eine Zopfnadel heben und vor der Arbeit halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περάστε τον πρώτο πόντο άπλεκτο σαν ανάποδη σε βοηθητική βελόνα και κρατήστε τον μπροστά από το πλεκτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip the first stitch purlwise to a cable needle and hold it in front of the fabric."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta ensimmäinen silmukka nurin neulomatta apupuikolle ja pidä se työn edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser la première maille comme à l’envers sur une aiguille auxiliaire et la tenir devant l’ouvrage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の1目を裏目の向きになわ編み針へ移し、編地の手前に置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 코를 안뜨기 방향으로 꽈배기바늘에 옮겨 편물 앞에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta første maske løs av som vrang på en hjelpepinne og hold den foran arbeidet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal de eerste steek averecht af op een kabelnaald en houd die voor het werk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft första maskan som avig till en hjälpsticka och håll den framför arbetet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上针方向滑第一针到麻花针，置于织片前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上針方向滑第一針到麻花針，置於織片前方。"
          }
        }
      }
    },
    "stitchDictionary.cable-left-two.accessibility.1": {
