    "stitchDictionary.make-one-right.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højrehældende udtagning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts geneigte Zunahme"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αύξηση με κλίση δεξιά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one right"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikealle kallistuva lisäys"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentation intercalaire droite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右傾斜のねじり増し目（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른코 늘리기-겉뜨기 (M1R)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyrevendt økning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtshellend meerderen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högerlutande ökning"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右倾扭加针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右傾扭加針"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej lænken mellem maskerne, og tilføj én højrehældende maske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Querfaden verdrehen und eine rechts geneigte Masche hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρίψτε το νήμα ανάμεσα σε πόντους για μία αύξηση με κλίση δεξιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twist the strand between stitches to add one right-leaning stitch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä silmukoiden välinen lanka yhdeksi oikealle kallistuvaksi lisäsilmukaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tordre le fil entre les mailles pour ajouter une maille inclinée à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡り糸をねじって、右に傾く目を1目増やします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코 사이의 가로실을 꼬아 오른쪽으로 기우는 코를 하나 늘립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri tråden mellom maskene og legg til én høyrevendt maske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De draad tussen steken verdraaien voor één rechtshellende steek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid tråden mellan maskorna och lägg till en högerlutande maska."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起针间横线扭织，增加一个右倾针目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起針間橫線扭織，增加一個右傾針目。"
          }
        }
      }
    },
