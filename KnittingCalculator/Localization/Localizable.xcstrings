          "stringUnit": {
            "state": "translated",
            "value": "Nosta nurin neulomatta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser comme à l’envers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "裏目の向きにすべらせる（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안뜨기 방향으로 걸러뜨기 (설명)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta løs av som vrang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Averecht afhalen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft som en avig maska"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上针方向滑针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上針方向滑針"
          }
        }
      }
    },
    "stitchDictionary.slip-purlwise.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt en ustrikket maske uden at ændre dens retning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Masche ungearbeitet übertragen, ohne ihre Ausrichtung zu ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρετε έναν άπλεκτο πόντο χωρίς να αλλάξετε τον προσανατολισμό του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer one unworked stitch without changing its orientation."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä silmukka neulomatta muuttamatta sen asentoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer une maille sans la tricoter ni changer son orientation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編まずに1目を移し、目の向きを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨지 않고 한 코를 옮겨 코의 방향을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt en ustrikket maske uten å endre retningen på den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een steek ongebreid overzetten zonder de richting te veranderen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta en ostickad maska utan att ändra dess riktning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不编织而移动一针，保留线圈朝向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不編織而移動一針，保留線圈朝向。"
          }
        }
      }
    },
    "stitchDictionary.slip-purlwise.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold garnet bagved i dette eksempel. Stik højre pind ind som til vrang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Beispiel liegt der Faden hinten. Die rechte Nadel wie zum Linksstricken einstechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αυτό το παράδειγμα κρατήστε το νήμα πίσω. Βάλτε τη δεξιά βελόνα σαν να πλέκατε ανάποδη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep yarn behind for this example. Insert the right needle as if to purl."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tässä esimerkissä lanka takana. Työnnä oikea puikko silmukkaan kuin neuloisit nurin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cet exemple, garder le fil derrière. Piquer l’aiguille droite comme pour tricoter à l’envers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この例では糸を向こう側に置き、裏目を編むように右針を入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예에서는 실을 뒤에 두고 안뜨기하듯 오른바늘을 넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold garnet bak i dette eksemplet. Stikk høyre pinne inn som om du skal strikke vrangt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd in dit voorbeeld het garen achter. Steek de rechternaald in alsof je averecht breit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll garnet bakom i detta exempel. Stick in höger sticka som om du ska sticka avigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本例将线置于后方，右针以上针方向插入线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本例將線置於後方，右針以上針方向插入線圈。"
          }
        }
      }
    },
