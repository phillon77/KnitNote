    "stitchDictionary.symbol.condition.slip-purlwise": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Retside: tag 1 vrang løs af, garn bagved. Vrangside: tag 1 vrang løs af, garn foran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechte Seite: 1 wie zum Linksstricken abheben, Faden hinten. Linke Seite: ebenso, Faden vorn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλή όψη: 1 άπλεκτος σαν ανάποδη, νήμα πίσω. Ανάποδη όψη: το ίδιο, νήμα μπροστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right side: slip 1 purlwise, yarn behind. Wrong side: slip 1 purlwise, yarn in front."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikea puoli: nosta 1 nurin neulomatta, lanka takana. Nurja puoli: sama, lanka edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endroit : glisser 1 comme à l’envers, fil derrière. Envers : glisser 1 comme à l’envers, fil devant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表側：裏目の向きに1目すべらせ、糸は向こう。裏側：同じ向きにすべらせ、糸は手前。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉면: 안뜨기 방향으로 1코 옮기고 실은 뒤. 안쪽 면: 같은 방향으로 옮기고 실은 앞."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettside: ta 1 løs av som vrang, garn bak. Vrangside: samme, garn foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goede kant: 1 averecht afhalen, garen achter. Verkeerde kant: hetzelfde, garen voor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rätsida: lyft 1 som avig, garn bakom. Avigsida: samma, garn framför."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正面：以上针方向滑一针，线在后。反面：以上针方向滑一针，线在前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正面：以上針方向滑一針，線在後。反面：以上針方向滑一針，線在前。"
          }
        }
      }
    },
