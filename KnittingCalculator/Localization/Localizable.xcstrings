    "stitchDictionary.symbol.rightSide": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vist fra retsiden; følg udgiverens tegnforklaring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der rechten Seite gezeigt; Verlagslegende beachten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όψη από την καλή πλευρά· ακολουθήστε το υπόμνημα του εκδότη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown from the right side; follow the publisher’s key."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvattu oikealta puolelta; noudata kustantajan selitettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue sur l’endroit ; suivre la légende de l’éditeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表側から見た記号です。出版社の凡例に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉면 기준입니다. 출판사의 기호 설명을 따르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vist fra rettsiden; følg utgiverens tegnforklaring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezien vanaf de goede kant; volg de legenda van de uitgever."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visat från rätsidan; följ förlagets teckenförklaring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从正面观看；请遵循出版社图例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從正面觀看；請遵循出版社圖例。"
          }
        }
      }
    },
    "stitchDictionary.note.context": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegningerne viser garn i højre hånd og normalt monterede masker. Foran er mod dig; bagved er væk fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bilder zeigen rechts geführtes Garn und normal montierte Maschen. Vorn bedeutet zum Körper, hinten vom Körper weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σχήματα δείχνουν νήμα στο δεξί χέρι και κανονική τοποθέτηση πόντων. Μπροστά σημαίνει προς εσάς, πίσω μακριά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawings use right-hand yarn and normally mounted stitches. Front means toward you; back means away from you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvissa lanka on oikeassa kädessä ja silmukat tavallisessa asennossa. Edessä tarkoittaa sinua kohti, takana sinusta poispäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dessins montrent le fil tenu à droite et des mailles montées normalement. Devant signifie vers soi, derrière signifie loin de soi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図は右手で糸を持ち、通常の向きに掛かった目を示します。手前は自分側、向こうは自分と反対側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림은 오른손에 실을 잡고 일반적인 방향으로 걸린 코를 기준으로 합니다. 앞은 몸 쪽, 뒤는 몸 반대쪽입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene viser garn i høyre hånd og normalt monterte masker. Foran betyr mot deg, bak betyr fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekeningen tonen garen in de rechterhand en normaal opgezette steken. Voor is naar je toe; achter is van je af."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna visar garn i höger hand och normalt monterade maskor. Framför är mot dig; bakom är bort från dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示为右手持线、线圈正常朝向。前方指朝自己，后方指远离自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示為右手持線、線圈正常朝向。前方指朝自己，後方指遠離自己。"
          }
        }
      }
    },
    "stitchDictionary.note.slip": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstiksretning og garnets placering er to forskellige valg. Følg opskriftens angivelse af garn foran eller bagved; flyt garnet mellem spidserne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abheberichtung und Fadenlage sind unabhängig. Das Muster bestimmt vorn oder hinten; den Faden zwischen den Spitzen verlegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φορά εισαγωγής και η θέση του νήματος είναι ανεξάρτητες. Ακολουθήστε το σχέδιο για μπροστά ή πίσω· μετακινήστε το νήμα ανάμεσα στις άκρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip direction and yarn position are independent. Follow the pattern for yarn front or back; move yarn between the tips."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nostotapa ja langan paikka ovat erillisiä valintoja. Noudata ohjeen etu- tai takapuolta ja siirrä lanka kärkien välistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sens de glissement et la position du fil sont indépendants. Suivre le patron pour le fil devant ou derrière ; le déplacer entre les pointes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべらせる向きと糸の位置は別の指定です。編み図の糸を手前・向こうに置く指示に従い、糸は針先の間で移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코를 옮기는 방향과 실의 위치는 별개입니다. 도안의 앞실·뒤실 지시를 따르고 실은 바늘 끝 사이로 옮기세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningen ved avløfting og garnets plassering er uavhengige. Følg mønsteret for garn foran eller bak; flytt garnet mellom spissene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhaalrichting en garenpositie zijn onafhankelijk. Volg het patroon voor garen voor of achter; verplaats het tussen de punten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyftriktning och garnets läge är oberoende. Följ mönstret för garn framför eller bakom; flytta garnet mellan spetsarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑针方向与线的位置是两件事。线放前或后须依图解；换线位时从两针尖之间移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑針方向與線的位置是兩件事。線放前或後須依織圖；換線位時從兩針尖之間移動。"
          }
        }
      }
    },
    "stitchDictionary.note.legend": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboler varierer mellem udgivere. En beskrivende oversættelse er ikke et standardnavn. Brug altid opskriftens egen tegnforklaring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole unterscheiden sich je nach Verlag. Eine beschreibende Übersetzung ist kein Normname. Immer die Legende des Musters verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σύμβολα διαφέρουν ανά εκδότη. Μια περιγραφική μετάφραση δεν είναι τυποποιημένος όρος. Χρησιμοποιείτε το υπόμνημα του σχεδίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbols vary by publisher. A descriptive translation is not a standardized name. Always use your pattern’s own key."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkit vaihtelevat kustantajittain. Kuvaileva käännös ei ole vakiintunut nimi. Käytä aina oman ohjeen selitettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les symboles varient selon l’éditeur. Une traduction descriptive n’est pas un nom normalisé. Utiliser la légende du patron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記号は出版社により異なります。「説明訳」は標準名称ではありません。必ず編み図の凡例を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기호는 출판사마다 다릅니다. ‘설명’으로 표시한 번역은 표준 명칭이 아닙니다. 도안 자체의 기호 설명을 따르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboler varierer mellom utgivere. En beskrivende oversettelse er ikke et standardnavn. Bruk alltid mønsterets egen tegnforklaring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolen verschillen per uitgever. Een beschrijvende vertaling is geen standaardnaam. Gebruik altijd de legenda van je patroon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboler varierar mellan förlag. En beskrivande översättning är inte ett standardnamn. Använd alltid mönstrets egen teckenförklaring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号因出版社而异。标为说明译名的名称并非标准术语；请以原图解图例为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符號因出版社而異。標為說明譯名的名稱並非標準術語；請以原織圖圖例為準。"
          }
        }
      }
    },
    "stitchDictionary.note.koLegend": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun denne koreanske kildes tegnforklaring. Den fastslår ikke en generel regel for vrangsider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Legende dieser koreanischen Quelle. Sie legt keine allgemeine Rückseitenregel fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο το υπόμνημα αυτής της κορεατικής πηγής. Δεν ορίζει γενικό κανόνα για την ανάποδη όψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Korean source’s key only. It does not establish a general wrong-side rule."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tämän korealaisen lähteen selite. Se ei määritä yleistä nurjan puolen sääntöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Légende propre à cette source coréenne. Elle n’établit pas de règle générale pour l’envers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この韓国教材の凡例に限る記号です。裏側の一般的な規則は示していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한국 교재의 기호 설명에만 해당합니다. 안쪽 면의 일반 규칙을 뜻하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare denne koreanske kildens tegnforklaring. Den fastsetter ingen generell regel for vrangsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de legenda van deze Koreaanse bron. Deze bepaalt geen algemene regel voor de verkeerde kant."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast denna koreanska källas teckenförklaring. Den anger ingen allmän regel för avigsidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对应这份韩国教材的图例，未据此推定通用反面规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅對應這份韓國教材的圖例，未據此推定通用反面規則。"
          }
        }
      }
    },
    "stitchDictionary.note.sskSkp": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK og SKP hælder begge mod venstre, men udføres forskelligt. Et japansk navn for hældningen beviser ikke samme teknik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK und SKP neigen sich beide nach links, werden aber anders gearbeitet. Ein japanischer Richtungsname beweist keine identische Technik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SSK και το SKP κλίνουν αριστερά αλλά εκτελούνται διαφορετικά. Ένα ιαπωνικό όνομα κλίσης δεν αποδεικνύει ίδια τεχνική."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK and SKP both lean left but use different operations. A Japanese slant name does not prove technique equivalence."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK ja SKP kallistuvat vasemmalle mutta tehdään eri tavoin. Japanilainen kallistuksen nimi ei todista samaa tekniikkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK et SKP penchent à gauche mais se travaillent différemment. Un nom japonais d’inclinaison ne prouve pas une technique identique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK と SKP は同じ左傾斜でも操作が異なります。日本語の傾きの名称だけでは同じ操作と判断できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK 와 SKP 는 모두 왼쪽으로 기울지만 동작이 다릅니다. 일본어의 기울기 이름만으로 같은 기법이라고 볼 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK og SKP heller begge mot venstre, men utføres forskjellig. Et japansk retningsnavn beviser ikke samme teknikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK en SKP hellen allebei naar links maar worden anders uitgevoerd. Een Japanse richtingsnaam bewijst geen gelijke techniek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK och SKP lutar båda åt vänster men görs olika. Ett japanskt riktningsnamn visar inte att tekniken är densamma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK 与 SKP 都左倾，但操作不同，不能只凭日文倾斜名称认定为同一种针法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK 與 SKP 都左傾，但操作不同，不能只憑日文傾斜名稱認定為同一種針法。"
          }
        }
      }
    },
    "stitchDictionary.note.yarnOver": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her vises omslag mellem retmasker. Nabomaskerne kan ændre garnets vej; strik ikke omslaget drejet, hvis hullet skal bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezeigt ist ein Umschlag zwischen rechten Maschen. Nachbarmaschen können den Fadenweg ändern; für ein Loch den Umschlag nicht verschränkt abstricken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνεται ζετέ ανάμεσα σε καλούς πόντους. Οι γειτονικοί πόντοι αλλάζουν τη διαδρομή του νήματος· μην το πλέξετε στριφτό αν θέλετε τρύπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shows a yarn over between knit stitches. Neighboring stitches change the yarn route; do not twist the loop if you want an eyelet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä langankierto on oikeiden silmukoiden välissä. Viereiset silmukat muuttavat langan kulkua; älä kierrä lenkkiä, jos haluat reiän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeté montré entre deux mailles endroit. Les mailles voisines modifient le trajet du fil ; ne pas tordre la boucle pour conserver le jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表目の間のかけ目を示します。前後の目で糸の運び方が変わります。透かし穴を残す場合は次の段でねじらず編みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉뜨기 사이의 바늘비우기 예입니다. 앞뒤 코에 따라 실의 경로가 달라집니다. 구멍을 남기려면 고리를 꼬아 뜨지 마세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her vises kast mellom rettmasker. Nabomaskene kan endre garnets vei; ikke vri løkken hvis hullet skal beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een omslag tussen rechte steken. Buursteken veranderen de draadroute; brei de lus niet gedraaid als je een gaatje wilt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här visas omslag mellan räta maskor. Grannmaskorna kan ändra garnets väg; vrid inte öglan om hålet ska behållas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此例为两个下针之间的挂针。相邻针法会影响绕线方式；要保留孔洞，下一行不要扭织挂针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此例為兩個下針之間的掛針。相鄰針法會影響繞線方式；要保留孔洞，下一行不要扭織掛針。"
          }
        }
      }
    },
    "stitchDictionary.note.cable": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Foran giver 1/1 LC; bagved giver 1/1 RC. Japanske navne beskriver, hvilken maske der ligger øverst, så oversæt ikke retningen ordret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorn halten ergibt 1/1 LC, hinten halten 1/1 RC. Japanische Namen nennen die oben liegende Masche; Richtungswörter nicht wörtlich übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπροστά δίνει 1/1 LC, πίσω δίνει 1/1 RC. Τα ιαπωνικά ονόματα περιγράφουν τον πόντο που μένει πάνω· μη μεταφράζετε κυριολεκτικά την κατεύθυνση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front hold makes 1/1 LC; back hold makes 1/1 RC. Japanese names describe the stitch on top, so do not translate direction words literally."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edessä pitäminen tuottaa 1/1 LC:n, takana 1/1 RC:n. Japanilaiset nimet kuvaavat päällimmäistä silmukkaa; älä käännä suuntaa kirjaimellisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attente devant : 1/1 LC ; derrière : 1/1 RC. Les noms japonais désignent la maille au-dessus ; ne pas traduire la direction littéralement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手前に休めると 1/1 LC、向こうに休めると 1/1 RC です。日本語は上になる目を示すため、英語の左右を直訳しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 두면 1/1 LC, 뒤에 두면 1/1 RC 입니다. 일본어 이름은 위에 오는 코를 가리키므로 방향을 그대로 번역하지 마세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Foran gir 1/1 LC, bak gir 1/1 RC. Japanske navn beskriver masken som ligger øverst; ikke oversett retningen ordrett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor houden geeft 1/1 LC, achter houden 1/1 RC. Japanse namen noemen de bovenliggende steek; vertaal richtingen niet letterlijk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Framför ger 1/1 LC, bakom ger 1/1 RC. Japanska namn beskriver maskan överst; översätt inte riktningen ordagrant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前置为 1/1 LC，后置为 1/1 RC。日文以位于上方的针目命名，左右不能直接逐字互译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前置為 1/1 LC，後置為 1/1 RC。日文以位於上方的針目命名，左右不能直接逐字互譯。"
          }
        }
      }
    },
    "stitchDictionary.note.kfb": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold den gamle maske til begge nye er strikket. Denne udtagning kan give en lille tværstreg; den er ikke en udtagning fra lænken mellem masker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Masche behalten, bis beide neuen gestrickt sind. Ein kleiner Querbalken kann entstehen; dies ist keine Querfadenzunahme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τον αρχικό πόντο μέχρι να πλεχτούν και οι δύο νέοι. Μπορεί να εμφανιστεί μικρή οριζόντια γραμμή· δεν είναι αύξηση από το ενδιάμεσο νήμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the original stitch until both new stitches are made. A small bar can show; this is not a between-stitches M1 increase."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä vanha silmukka, kunnes molemmat uudet on neulottu. Pieni poikkilanka voi näkyä; tämä ei ole silmukoiden välinen M1-lisäys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la maille d’origine jusqu’à avoir tricoté les deux nouvelles. Une petite barre peut apparaître ; ce n’est pas une augmentation intercalaire M1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2目とも編むまで元の目を外しません。小さな横線が出ることがあります。渡り糸を使う M1 とは異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 코 두 개를 모두 만들 때까지 원래 코를 빼지 마세요. 작은 가로선이 생길 수 있습니다. 코 사이의 실로 하는 M1 과 다릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold den gamle masken til begge nye er strikket. En liten tverrstrek kan vises; dette er ikke en M1-økning fra tråden mellom masker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de oorspronkelijke steek tot beide nieuwe gebreid zijn. Er kan een klein dwarsbalkje ontstaan; dit is geen M1-meerdering uit de tussendraad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll den gamla maskan tills båda nya är stickade. En liten tvärtråd kan synas; detta är inte en M1-ökning ur tråden mellan maskor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两针都织好后才放开旧线圈。可能出现小横杠；这与挑针间横线的 M1 加针不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩針都織好後才放開舊線圈。可能出現小橫槓；這與挑針間橫線的 M1 加針不同。"
          }
        }
      }
    },
    "stitchDictionary.knit.note.englishMethod": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegningerne viser garn i højre hånd og normalt monterede masker. Foran er mod dig; bagved er væk fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bilder zeigen rechts geführtes Garn und normal montierte Maschen. Vorn bedeutet zum Körper, hinten vom Körper weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σχήματα δείχνουν νήμα στο δεξί χέρι και κανονική τοποθέτηση πόντων. Μπροστά σημαίνει προς εσάς, πίσω μακριά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawings use right-hand yarn and normally mounted stitches. Front means toward you; back means away from you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvissa lanka on oikeassa kädessä ja silmukat tavallisessa asennossa. Edessä tarkoittaa sinua kohti, takana sinusta poispäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dessins montrent le fil tenu à droite et des mailles montées normalement. Devant signifie vers soi, derrière signifie loin de soi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図は右手で糸を持ち、通常の向きに掛かった目を示します。手前は自分側、向こうは自分と反対側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림은 오른손에 실을 잡고 일반적인 방향으로 걸린 코를 기준으로 합니다. 앞은 몸 쪽, 뒤는 몸 반대쪽입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene viser garn i høyre hånd og normalt monterte masker. Foran betyr mot deg, bak betyr fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekeningen tonen garen in de rechterhand en normaal opgezette steken. Voor is naar je toe; achter is van je af."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna visar garn i höger hand och normalt monterade maskor. Framför är mot dig; bakom är bort från dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示为右手持线、线圈正常朝向。前方指朝自己，后方指远离自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示為右手持線、線圈正常朝向。前方指朝自己，後方指遠離自己。"
          }
        }
      }
    },
    "stitchDictionary.symbol.koreanCondition": {
