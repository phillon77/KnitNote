    "stitchDictionary.k2tog.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad begge gamle masker glide af sammen. Én ny maske er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide alten Maschen zusammen abgleiten lassen. Eine neue Masche bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε και τους δύο παλιούς πόντους μαζί. Μένει ένας νέος πόντος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release both old loops together. One new stitch remains."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota molemmat vanhat silmukat yhdessä. Yksi uusi silmukka jää jäljelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser tomber les deux anciennes mailles ensemble. Il reste une nouvelle maille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の2目を一緒に外します。新しい目が1目残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 두 코를 함께 빼면 새 코 하나가 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La begge gamle masker gli av sammen. Én ny maske er igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat beide oude lussen tegelijk los. Er blijft één nieuwe steek over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt båda gamla maskorna glida av tillsammans. En ny maska återstår."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个旧线圈一起滑离左针，留下一个新针目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個舊線圈一起滑離左針，留下一個新針目。"
          }
        }
      }
    },
