        }
      }
    },
    "stitchDictionary.make-one-right.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip den løftede løkke. Én maske er tilføjet; næste maske hører ikke til M1R."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgenommene Schlinge abgleiten lassen. Eine Masche ist hinzugekommen; die nächste Masche gehört nicht zu M1R."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τη σηκωμένη θηλιά. Προστέθηκε ένας πόντος· ο επόμενος δεν ανήκει στο M1R."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the lifted strand; one extra stitch remains. Do not work the next stitch as part of M1R."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota nostettu lenkki. Yksi silmukka on lisätty; seuraava silmukka ei kuulu M1R-lisäykseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérer la boucle relevée : une maille est ajoutée. La maille suivante ne fait pas partie de M1R."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すくったループを外すと1目増えます。次の目は M1R に含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어 올린 고리를 빼면 한 코가 늘어납니다. 다음 코는 M1R 에 포함하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp den løftede løkken. Én maske er lagt til; neste maske er ikke en del av M1R."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de opgenomen lus los. Er is één steek bij; de volgende steek hoort niet bij M1R."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp den lyfta öglan. En maska har lagts till; nästa maska ingår inte i M1R."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起的线圈滑离左针，增加一针；下一针不属于 M1R。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑起的線圈滑離左針，增加一針；下一針不屬於 M1R。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.accessibility.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
