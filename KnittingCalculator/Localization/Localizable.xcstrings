            "value": "왼바늘로 코 사이의 가로실을 뒤에서 앞으로 들어 올립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft tråden mellom maskene med venstre pinne bakfra og fremover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem met de linkernaald de tussendraad van achteren naar voren op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft tråden mellan maskorna med vänster sticka bakifrån och framåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用左针由后往前挑起两针之间的横线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用左針由後往前挑起兩針之間的橫線。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.accessibility.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Løft lænken mellem maskerne med venstre pind bagfra og frem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnung: Den Querfaden zwischen den Maschen mit der linken Nadel von hinten nach vorn aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Σηκώστε το ενδιάμεσο νήμα με την αριστερή βελόνα από πίσω προς τα εμπρός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: With the left needle, lift the strand between stitches from back to front."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Nosta silmukoiden välinen lanka vasemmalla puikolla takaa eteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Avec l’aiguille gauche, relever le fil entre les mailles de l’arrière vers l’avant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：目と目の間の渡り糸を、左針で向こうから手前へすくいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 왼바늘로 코 사이의 가로실을 뒤에서 앞으로 들어 올립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Løft tråden mellom maskene med venstre pinne bakfra og fremover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Neem met de linkernaald de tussendraad van achteren naar voren op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Lyft tråden mellan maskorna med vänster sticka bakifrån och framåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：用左针由后往前挑起两针之间的横线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：用左針由後往前挑起兩針之間的橫線。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik ret i den løftede løkkes forreste lænke, så løkken drejes og hullet lukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aufgenommenen Faden durch das vordere Glied rechts stricken; die Drehung schließt das Loch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε καλή στο μπροστινό σκέλος της σηκωμένης θηλιάς, στρίβοντάς την ώστε να κλείσει η τρύπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit into the front leg of the lifted strand, twisting it closed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo nostetun lenkin etureunasta oikein, jolloin lenkki kiertyy ja reikä sulkeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter le brin avant à l’endroit pour tordre la boucle et fermer le trou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すくったループの手前側を表編みし、ねじって穴を閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어 올린 고리의 앞쪽을 겉뜨기해 실이 꼬여 구멍이 닫히게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk rett i fremre ledd av den løftede løkken, slik at den vris og hullet lukkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei recht door de voorste lus om de draad te verdraaien en het gaatje te sluiten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka rätt i den lyfta öglans främre båge så att öglan vrids och hålet stängs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织挑起线圈的前半针，使横线扭转闭合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織挑起線圈的前半針，使橫線扭轉閉合。"
          }
        }
      }
    },
    "stitchDictionary.make-one-right.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
