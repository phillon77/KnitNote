{
  "sourceLanguage" : "en",
  "strings" : {
    "app.title" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Knitting Calculator"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "編織計算器"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "编织计算器"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Strickrechner"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Calculateur de tricot"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "編み物計算機"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "뜨개질 계산기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Breicalculator"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Strikkekalkulator"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Stickkalkylator"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Neulelaskuri"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Strikkeberegner"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Αριθμομηχανή Πλεξίματος"}}}},
    "app.home.title" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "What would you like to calculate?"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "今天要計算什麼？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "想计算什么？"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Was möchten Sie berechnen?"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Que souhaitez-vous calculer ?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "何を計算しますか？"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "무엇을 계산할까요?"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Wat wilt u berekenen?"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Hva vil du beregne?"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Vad vill du beräkna?"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Mitä haluat laskea?"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Hvad vil du beregne?"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Τι θέλετε να υπολογίσετε;"}}}},
    "app.settings.title" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Settings"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "設定"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Einstellungen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Réglages"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "設定"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Instellingen"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Innstillinger"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Inställningar"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Asetukset"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Indstillinger"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Ρυθμίσεις"}}}},
    "calculator.home.gauge.description" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Find stitch and row counts for your finished size."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "計算成品尺寸需要的針數與排數。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "计算成品尺寸所需的针数和行数。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Ermitteln Sie Maschen- und Reihenzahlen für die gewünschte Endgröße."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Calculez le nombre de mailles et de rangs pour les dimensions finales."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "仕上がり寸法に必要な目数と段数を計算します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "완성 크기에 필요한 코 수와 단 수를 계산합니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Bereken het aantal steken en toeren voor de uiteindelijke afmetingen."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Finn antall masker og rader for den ferdige størrelsen."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Beräkna antalet maskor och varv för den färdiga storleken."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Laske valmiin koon silmukka- ja kerrosmäärät."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Beregn maske- og rækketal til den færdige størrelse."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Βρείτε τον αριθμό πόντων και σειρών για το τελικό μέγεθος."}}}},
    "calculator.home.adjustment.description" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Space increases or decreases evenly in your knitting."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "平均安排編織中的加針或減針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "均匀安排编织中的加针或减针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Verteilen Sie Zunahmen oder Abnahmen gleichmäßig in Ihrem Strickstück."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Répartissez régulièrement les augmentations ou diminutions dans votre tricot."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "編み地の増し目や減らし目を均等に配置します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "뜨개질의 코 늘리기나 코 줄이기를 고르게 배치합니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Verdeel meerderingen of minderingen gelijkmatig over uw breiwerk."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Fordel økninger eller fellinger jevnt i strikketøyet."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Fördela ökningar eller minskningar jämnt i stickningen."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Jaa lisäykset tai kavennukset tasaisesti neuleeseen."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Fordel udtagninger eller indtagninger jævnt i strikketøjet."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Κατανείμετε ομοιόμορφα τις αυξήσεις ή τις μειώσεις στο πλεκτό σας."}}}},
    "calculator.promotion.description" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Need to manage projects, row counts, yarn, patterns, and a knitting journal? Meet KnitNote."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "需要管理作品、排數、毛線、織圖與編織日記？認識 KnitNote。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要管理作品、行数、毛线、图解和编织日志？认识 KnitNote。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Möchten Sie Projekte, Reihenzahlen, Garn, Muster und ein Stricktagebuch verwalten? Lernen Sie KnitNote kennen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Besoin de gérer vos projets, rangs, fils, patrons et votre journal de tricot ? Découvrez KnitNote."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "作品、段数、毛糸、編み図、編み物日記を管理したいですか？KnitNoteをご紹介します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "프로젝트, 단 수, 실, 도안과 뜨개 일지를 관리하고 싶으신가요? KnitNote를 만나 보세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Wilt u projecten, toerentellingen, garen, patronen en een breidagboek beheren? Maak kennis met KnitNote."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Vil du administrere prosjekter, radtelling, garn, mønstre og en strikkedagbok? Bli kjent med KnitNote."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Vill du hantera projekt, varvräkning, garn, mönster och en stickdagbok? Upptäck KnitNote."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Haluatko hallita projekteja, kerrosmääriä, lankoja, ohjeita ja neulepäiväkirjaa? Tutustu KnitNoteen."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Vil du administrere projekter, rækketælling, garn, opskrifter og en strikkedagbog? Mød KnitNote."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Θέλετε να διαχειρίζεστε έργα, μετρήσεις σειρών, νήματα, σχέδια και ημερολόγιο πλεξίματος; Γνωρίστε το KnitNote."}}}},
    "calculator.promotion.product.relationship" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote is a separate app."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote 是另一款獨立 App。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote 是一款独立应用。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote ist eine eigenständige App."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote est une application distincte."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "KnitNoteは別のアプリです。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote는 별도의 앱입니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote is een aparte app."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote er en egen app."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote är en separat app."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote on erillinen sovellus."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote er en separat app."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Το KnitNote είναι ξεχωριστή εφαρμογή."}}}},
    "calculator.promotion.action" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Meet KnitNote"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "認識 KnitNote"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "认识 KnitNote"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote kennenlernen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Découvrir KnitNote"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "KnitNoteを見る"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote 알아보기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Maak kennis met KnitNote"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Bli kjent med KnitNote"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Upptäck KnitNote"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tutustu KnitNoteen"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Mød KnitNote"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Γνωρίστε το KnitNote"}}}},
    "calculator.promotion.action.accessibility" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Open KnitNote"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "開啟 KnitNote"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "打开 KnitNote"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote öffnen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Ouvrir KnitNote"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "KnitNoteを開く"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote 열기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote openen"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Åpne KnitNote"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Öppna KnitNote"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Avaa KnitNote"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Åbn KnitNote"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Άνοιγμα KnitNote"}}}},
    "calculator.promotion.action.hint" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Opens KnitNote if it is installed, otherwise opens its App Store page."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已安裝時開啟 KnitNote，否則開啟其 App Store 頁面。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "如果已安装则打开 KnitNote，否则打开其 App Store 页面。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Öffnet KnitNote, wenn es installiert ist, andernfalls die zugehörige App-Store-Seite."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Ouvre KnitNote si l’application est installée, sinon ouvre sa page dans l’App Store."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "KnitNoteがインストールされていれば開き、なければApp Storeのページを開きます。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote가 설치되어 있으면 열고, 없으면 App Store 페이지를 엽니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Opent KnitNote als de app is geïnstalleerd, anders wordt de App Store-pagina geopend."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Åpner KnitNote hvis appen er installert, ellers åpnes App Store-siden."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Öppnar KnitNote om appen är installerad, annars öppnas dess App Store-sida."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Avaa KnitNoten, jos se on asennettu, tai muussa tapauksessa sen App Store -sivun."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Åbner KnitNote, hvis appen er installeret, ellers åbnes dens App Store-side."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Ανοίγει το KnitNote αν είναι εγκατεστημένο, διαφορετικά ανοίγει τη σελίδα του στο App Store."}}}},
    "calculator.settings.unit.section" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Units"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "單位"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "单位"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Einheiten"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Unités"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "単位"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "단위"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Eenheden"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Enheter"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Enheter"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Yksiköt"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Enheder"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Μονάδες"}}}},
    "calculator.settings.data.section" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Saved Inputs"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "已儲存的輸入"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的输入"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Gespeicherte Eingaben"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Saisies enregistrées"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "保存済みの入力"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "저장된 입력"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Bewaarde invoer"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Lagrede inndata"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Sparade inmatningar"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tallennetut syötteet"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Gemte indtastninger"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Αποθηκευμένες τιμές"}}}},
    "calculator.settings.reset" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear remembered inputs"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除記住的輸入"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除记住的输入"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Gespeicherte Eingaben löschen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Effacer les saisies mémorisées"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "記憶した入力を消去"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기억된 입력 지우기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Onthouden invoer wissen"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Fjern huskede inndata"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Rensa ihågkomna inmatningar"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tyhjennä muistetut syötteet"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Ryd huskede indtastninger"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εκκαθάριση αποθηκευμένων τιμών"}}}},
    "calculator.settings.reset.hint" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clears calculator inputs while keeping your unit and app counters."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "清除計算器輸入，但保留單位與 App 計數。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除计算器输入，同时保留单位和应用计数。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Löscht die Rechnereingaben, behält aber Einheit und App-Zähler bei."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Efface les saisies du calculateur tout en conservant l’unité et les compteurs de l’application."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "計算機の入力を消去しますが、単位とアプリのカウントは保持します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "계산기 입력을 지우되 단위와 앱 횟수는 유지합니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Wist de invoer van de calculator, maar behoudt uw eenheid en app-tellers."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Fjerner inndata i kalkulatoren, men beholder enhet og app-tellere."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Rensar kalkylatorns inmatningar men behåller enhet och appens räknare."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tyhjentää laskurin syötteet mutta säilyttää yksikön ja sovelluksen laskurit."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Rydder beregnerens indtastninger, men bevarer enhed og appens tællere."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Διαγράφει τις τιμές της αριθμομηχανής, διατηρώντας τη μονάδα και τους μετρητές της εφαρμογής."}}}},
    "calculator.settings.reset.confirmation.title" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear remembered inputs?"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "要清除記住的輸入嗎？"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除记住的输入？"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Gespeicherte Eingaben löschen?"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Effacer les saisies mémorisées ?"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "記憶した入力を消去しますか？"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "기억된 입력을 지울까요?"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Onthouden invoer wissen?"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Fjerne huskede inndata?"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Rensa ihågkomna inmatningar?"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tyhjennetäänkö muistetut syötteet?"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Ryd huskede indtastninger?"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εκκαθάριση αποθηκευμένων τιμών;"}}}},
    "calculator.settings.reset.confirmation.message" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This clears only the calculator inputs saved on this device."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "只會清除儲存在此裝置上的計算器輸入。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只会清除此设备上保存的计算器输入。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Dadurch werden nur die auf diesem Gerät gespeicherten Rechnereingaben gelöscht."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Seules les saisies du calculateur enregistrées sur cet appareil seront effacées."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このデバイスに保存された計算機の入力だけを消去します。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 기기에 저장된 계산기 입력만 지웁니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Hiermee wordt alleen de op dit apparaat bewaarde invoer van de calculator gewist."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Dette fjerner bare kalkulatorinndata som er lagret på denne enheten."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Detta rensar endast kalkylatorinmatningar som sparats på den här enheten."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tämä tyhjentää vain tälle laitteelle tallennetut laskurin syötteet."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Dette rydder kun beregnerens indtastninger, der er gemt på denne enhed."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Διαγράφονται μόνο οι τιμές της αριθμομηχανής που έχουν αποθηκευτεί σε αυτή τη συσκευή."}}}},
    "calculator.settings.reset.cancel" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cancel"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "取消"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "取消"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Abbrechen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Annuler"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "キャンセル"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "취소"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Annuleer"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Avbryt"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Avbryt"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Peruuta"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Annuller"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Ακύρωση"}}}},
    "calculator.settings.knitnote.section" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote App"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote 应用"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote-App"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Application KnitNote"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "KnitNoteアプリ"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote 앱"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote-app"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote-app"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote-app"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote-sovellus"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "KnitNote-app"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εφαρμογή KnitNote"}}}},
    "calculator.settings.support.section" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Support"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "支援"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "支持"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Hilfe"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Assistance"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "サポート"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "지원"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Ondersteuning"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Kundestøtte"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Hjälp"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tuki"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Hjælp"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Υποστήριξη"}}}},
    "calculator.settings.feedback" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Send feedback"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "傳送意見回饋"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "发送反馈"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Feedback senden"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Envoyer un commentaire"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "フィードバックを送信"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "피드백 보내기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Stuur feedback"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Send tilbakemelding"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Skicka feedback"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Lähetä palautetta"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Send en tilbagemelding"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Αποστολή σχολίων"}}}},
    "calculator.settings.privacy" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Privacy policy"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "隱私權政策"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "隐私政策"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Datenschutz"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Politique de confidentialité"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "プライバシーポリシー"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "개인정보 처리방침"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Privacybeleid"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Personvern"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Integritetspolicy"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tietosuojakäytäntö"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Anonymitetspolitik"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Πολιτική απορρήτου"}}}},
    "calculator.settings.about.section" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "About"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "關於"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关于"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Info"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "À propos"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "このアプリについて"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "정보"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Info"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Om"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Om"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tietoja"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Om"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Πληροφορίες"}}}},
    "calculator.settings.version" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Version"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "版本"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "版本"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "App-Version"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Nº de version"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バージョン"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "버전"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Versie"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Versjon"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Appversion"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Versio"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Appversion"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Έκδοση"}}}},
    "calculator.settings.version.format" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Version %@ (%@)"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "版本 %@（%@）"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "版本 %@（%@）"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "App-Version %@ (%@)"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Version nº %@ (%@)"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "バージョン %@（%@）"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "버전 %@ (%@)"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Versie %@ (%@)"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Versjon %@ (%@)"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Appversion %@ (%@)"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Versio %@ (%@)"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Appversion %@ (%@)"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Έκδοση %@ (%@)"}}}},
    "calculator.help.title" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "How It Works"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "使用說明"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "使用说明"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "So funktioniert es"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Fonctionnement"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "使い方"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "사용 방법"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Zo werkt het"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Slik fungerer det"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Så fungerar det"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Näin se toimii"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Sådan fungerer det"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Πώς λειτουργεί"}}}},
    "calculator.help.gauge" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Measure a swatch, enter its size and stitch count, then enter your target size. Example: 20 stitches across 10 cm becomes 80 stitches across 40 cm."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "量好試片後輸入尺寸與針數，再輸入目標尺寸。例如：10 公分 20 針，40 公分建議 80 針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "测量小样，输入其尺寸和针数，再输入目标尺寸。例如：10 厘米 20 针，40 厘米需要 80 针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Messen Sie eine Maschenprobe, geben Sie Größe und Maschenzahl ein und anschließend die Zielgröße. Beispiel: 20 Maschen auf 10 cm ergeben 80 Maschen auf 40 cm."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Mesurez un échantillon, saisissez ses dimensions et son nombre de mailles, puis la dimension souhaitée. Exemple : 20 mailles sur 10 cm donnent 80 mailles sur 40 cm."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "スワッチを測り、寸法と目数、続いて目標寸法を入力します。例：10 cmで20目なら、40 cmでは80目です。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "스와치를 측정하고 크기와 코 수를 입력한 다음 목표 크기를 입력하세요. 예: 10cm에 20코라면 40cm에는 80코입니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Meet een proeflap, voer de afmetingen en het aantal steken in en voer daarna de gewenste afmeting in. Voorbeeld: 20 steken per 10 cm worden 80 steken per 40 cm."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Mål en strikkeprøve, angi størrelsen og antall masker, og angi deretter målstørrelsen. Eksempel: 20 masker på 10 cm blir 80 masker på 40 cm."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Mät ett stickprov, ange dess storlek och antal maskor och ange sedan målstorleken. Exempel: 20 maskor på 10 cm blir 80 maskor på 40 cm."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Mittaa mallitilkku, syötä sen koko ja silmukkamäärä ja sitten tavoitekoko. Esimerkki: 20 silmukkaa 10 cm:llä tarkoittaa 80 silmukkaa 40 cm:llä."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Mål en strikkeprøve, indtast størrelse og masketal, og indtast derefter målstørrelsen. Eksempel: 20 masker på 10 cm bliver 80 masker på 40 cm."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Μετρήστε ένα δείγμα, εισαγάγετε τις διαστάσεις και τους πόντους του και έπειτα το επιθυμητό μέγεθος. Παράδειγμα: 20 πόντοι σε 10 cm γίνονται 80 πόντοι σε 40 cm."}}}},
    "calculator.help.adjustment" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter the current and target stitch counts for one row, or spread a total adjustment across rows. Example: increasing from 80 to 90 adds 10 stitches evenly."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "單行可輸入目前與目標針數，也可把總調整分配到多排。例如：80 針增加到 90 針，會平均安排 10 次加針。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "输入单行的当前和目标针数，或将总调整分配到多行。例如：从 80 针增加到 90 针，会均匀加 10 针。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Geben Sie aktuelle und gewünschte Maschenzahl für eine Reihe ein oder verteilen Sie die gesamte Anpassung über mehrere Reihen. Beispiel: Von 80 auf 90 werden 10 Maschen gleichmäßig zugenommen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Saisissez le nombre actuel et souhaité de mailles pour un rang, ou répartissez l’ajustement sur plusieurs rangs. Exemple : passer de 80 à 90 ajoute régulièrement 10 mailles."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1段の現在と目標の目数を入力するか、全体の調整を複数段に分けます。例：80目から90目にする場合、10目を均等に増やします。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "한 단의 현재 코 수와 목표 코 수를 입력하거나 전체 조정을 여러 단에 나누세요. 예: 80코에서 90코로 늘리면 10코를 고르게 늘립니다."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Voer voor één toer het huidige en gewenste aantal steken in of verdeel de totale aanpassing over meerdere toeren. Voorbeeld: van 80 naar 90 voegt gelijkmatig 10 steken toe."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Angi gjeldende og ønsket masketall for én rad, eller fordel hele justeringen over flere rader. Eksempel: Fra 80 til 90 økes det jevnt med 10 masker."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Ange aktuellt och önskat maskantal för ett varv, eller fördela hela justeringen över flera varv. Exempel: från 80 till 90 ökar jämnt med 10 maskor."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Syötä yhden kerroksen nykyinen ja tavoiteltu silmukkamäärä tai jaa koko muutos usealle kerrokselle. Esimerkki: 80 silmukasta 90:een lisätään tasaisesti 10 silmukkaa."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Indtast det aktuelle og ønskede masketal for én række, eller fordel den samlede justering over flere rækker. Eksempel: Fra 80 til 90 tages 10 masker jævnt ud."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εισαγάγετε τους τρέχοντες και επιθυμητούς πόντους για μία σειρά ή κατανείμετε τη συνολική προσαρμογή σε πολλές σειρές. Παράδειγμα: από 80 σε 90 προστίθενται ομοιόμορφα 10 πόντοι."}}}},
    "calculator.help.dismiss" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Done"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "完成"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "完成"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Fertig"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Terminé"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "完了"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "완료"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Gereed"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Ferdig"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Klar"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Valmis"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Færdig"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Τέλος"}}}},
