    "stitchDictionary.knit-front-back.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip den gamle maske. Der er nu to nye masker på højre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Masche abgleiten lassen. Rechts liegen jetzt zwei neue Maschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τον αρχικό πόντο. Δύο νέοι πόντοι μένουν στη δεξιά βελόνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the original loop. Two new stitches remain on the right needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota vanha silmukka. Oikealle puikolle jää kaksi uutta silmukkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser tomber la maille d’origine. Deux nouvelles mailles restent à droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の目を外します。右針には新しい目が2目残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 코를 왼바늘에서 뺍니다. 오른바늘에 새 코 두 개가 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp den gamle masken. To nye masker er igjen på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de oorspronkelijke steek los. Er staan twee nieuwe steken op de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp den gamla maskan. Två nya maskor finns på höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧线圈滑离左针，右针上留下两个新针目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊線圈滑離左針，右針上留下兩個新針目。"
          }
        }
      }
    },
    "stitchDictionary.knit-front-back.accessibility.3": {
