{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knitting Calculator"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編織計算器"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编织计算器"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strickrechner"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculateur de tricot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編み物計算機"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨개질 계산기"
          }
        },
        "nl": {
