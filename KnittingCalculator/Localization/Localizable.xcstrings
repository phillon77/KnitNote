    "calculator.adjustment.step.increaseOne" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Increase 1 stitch"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "加 1 針"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "加 1 针"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "1 Masche zunehmen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Augmenter d’1 maille"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "1目増し目する"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "1코 늘리기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Meerder 1 steek"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Øk 1 maske"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Öka 1 maska"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Lisää 1 silmukka"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Tag 1 maske ud"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Αυξήστε κατά 1 πόντο"}}}},
    "calculator.adjustment.step.decreaseOne" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Decrease the next 2 stitches to 1"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "將接下來 2 針減為 1 針"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "将接下来的 2 针并为 1 针"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Die nächsten 2 Maschen zu 1 Masche zusammenstricken"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Tricoter les 2 mailles suivantes ensemble"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "次の2目を1目に減らす"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "다음 2코를 1코로 줄이기"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Brei de volgende 2 steken samen"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Strikk de neste 2 maskene sammen"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Sticka nästa 2 maskor tillsammans"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Neulo seuraavat 2 silmukkaa yhteen"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Strik de næste 2 masker sammen"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Πλέξτε τους επόμενους 2 πόντους μαζί"}}}},
    "calculator.adjustment.accessibility.summary.edge.format" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. %2$@"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。%2$@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。%2$@"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Außerdem: %2$@"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Puis %2$@"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "%1$@。%2$@"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. 이어서 %2$@"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Daarna %2$@"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Deretter %2$@"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Därefter %2$@"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Sitten %2$@"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Derefter %2$@"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "%1$@. Έπειτα %2$@"}}}},
    "calculator.adjustment.failure.invalidCounts" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter positive stitch counts."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入大於 0 的針數。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入大于 0 的针数。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Geben Sie positive Maschenzahlen ein."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Saisissez des nombres de mailles positifs."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "0より大きい目数を入力してください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "0보다 큰 코 수를 입력하세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Voer positieve aantallen steken in."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Angi positive masketall."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Ange positiva maskantal."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Syötä positiiviset silmukkamäärät."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Indtast positive masketal."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εισαγάγετε θετικούς αριθμούς πόντων."}}}},
    "calculator.adjustment.failure.exceedsSupportedLimit" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter a value of 100,000 or less."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "請輸入不超過 100,000 的數值。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入不超过 100,000 的数值。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Geben Sie einen Wert bis 100.000 ein."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Saisissez une valeur inférieure ou égale à 100 000."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "100,000以下の値を入力してください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "100,000 이하의 값을 입력하세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Voer een waarde van maximaal 100.000 in."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Angi en verdi på 100 000 eller mindre."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Ange ett värde på högst 100 000."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Syötä enintään 100 000."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Indtast en værdi på højst 100.000."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Εισαγάγετε τιμή έως 100.000."}}}},
    "calculator.adjustment.failure.cannotPreserveEdges" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "These counts cannot reserve one stitch at each edge. Turn off edge stitches or change the counts."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這組針數無法左右各保留 1 針，請關閉邊針或調整針數。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这组针数无法在两侧各保留 1 针。请关闭边针选项或更改针数。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Bei diesen Zahlen kann nicht an jeder Seite eine Randmasche bleiben. Deaktivieren Sie die Randmaschen oder ändern Sie die Zahlen."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Ces nombres ne permettent pas de réserver une maille lisière de chaque côté. Désactivez les lisières ou modifiez les nombres."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この目数では左右に端目を1目ずつ残せません。端目をオフにするか、目数を変更してください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 코 수로는 양쪽에 가장자리 코를 1코씩 남길 수 없습니다. 가장자리 코를 끄거나 코 수를 변경하세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Bij deze aantallen kan niet aan elke kant één kantsteek worden behouden. Schakel kantsteken uit of wijzig de aantallen."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Disse tallene tillater ikke én kantmaske på hver side. Slå av kantmasker eller endre tallene."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "De här antalen kan inte behålla en kantmaska på varje sida. Stäng av kantmaskor eller ändra antalen."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Näillä määrillä ei voi jättää yhtä reunasilmukkaa kummallekin puolelle. Poista reunasilmukat käytöstä tai muuta määriä."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Disse tal kan ikke bevare én kantmaske i hver side. Slå kantmasker fra, eller skift tallene."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Με αυτούς τους αριθμούς δεν μπορεί να διατηρηθεί ένας ακριανός πόντος σε κάθε πλευρά. Απενεργοποιήστε τους ακριανούς πόντους ή αλλάξτε τους αριθμούς."}}}},
    "calculator.adjustment.failure.requiresMultipleRows" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This adjustment cannot fit in one row. Use Across Rows."}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "這次調整無法在單行完成，請改用跨排。"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此调整无法在一行内完成。请使用跨行调整。"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Diese Anpassung passt nicht in eine Reihe. Verwenden Sie „Über mehrere Reihen“."}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Cet ajustement ne tient pas sur un seul rang. Utilisez « Sur plusieurs rangs »."}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "この調整は1段に収まりません。「複数段」を使用してください。"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "이 조정은 한 단에 배치할 수 없습니다. ‘여러 단’을 사용하세요."}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Deze aanpassing past niet in één toer. Gebruik ‘Over meerdere toeren’."}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Denne justeringen får ikke plass på én rad. Bruk «Over flere rader»."}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Den här justeringen får inte plats på ett varv. Använd ”Över flera varv”."}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Tämä säätö ei mahdu yhdelle kerrokselle. Käytä vaihtoehtoa ”Usealle kerrokselle”."}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Denne justering kan ikke være på én række. Brug “Over flere rækker”."}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Αυτή η προσαρμογή δεν χωρά σε μία σειρά. Χρησιμοποιήστε την επιλογή «Σε πολλές σειρές»."}}}},
    "calculator.adjustment.rows.input.title" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Across-rows adjustment"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "跨排調整"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "跨行调整"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "Anpassung über mehrere Reihen"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Ajustement sur plusieurs rangs"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "複数段での調整"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "여러 단 조정"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "Aanpassing over meerdere toeren"}}, "nb" : {"stringUnit" : {"state" : "translated", "value" : "Justering over flere rader"}}, "sv" : {"stringUnit" : {"state" : "translated", "value" : "Justering över flera varv"}}, "fi" : {"stringUnit" : {"state" : "translated", "value" : "Usean kerroksen säätö"}}, "da" : {"stringUnit" : {"state" : "translated", "value" : "Justering over flere rækker"}}, "el" : {"stringUnit" : {"state" : "translated", "value" : "Προσαρμογή σε πολλές σειρές"}}}},
