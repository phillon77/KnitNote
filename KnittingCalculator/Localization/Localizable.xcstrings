          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet foran. Stikk høyre pinne som til vrang gjennom de neste to maskene samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Garen voor. Steek de rechternaald averecht in de volgende twee lussen tegelijk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Garnet framför. Stick höger sticka som för avigt genom nästa två maskor samtidigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：线置于前方，右针以上针方向同时插入接下来两个线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：線置於前方，右針以上針方向同時插入接下來兩個線圈。"
          }
        }
      }
    },
    "stitchDictionary.p2tog.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå garnet om, og træk én ny løkke bagud gennem begge gamle masker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden umlegen und eine neue Schlinge nach hinten durch beide alten Maschen ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τυλίξτε το νήμα και τραβήξτε μία νέα θηλιά προς τα πίσω μέσα από τους δύο παλιούς πόντους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap yarn and draw one new loop through both old loops, away from you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä lanka ja vedä yksi uusi lenkki molempien vanhojen silmukoiden läpi taakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrouler le fil et tirer une nouvelle boucle vers l’arrière à travers les deux anciennes mailles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸をかけ、元の2目から新しいループを向こう側へ引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 감고 두 코 사이로 새 고리를 뒤쪽으로 빼냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg garnet rundt og trekk én ny løkke bakover gjennom begge gamle masker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla het garen om en trek één nieuwe lus naar achteren door beide oude lussen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg garnet runt och dra en ny ögla bakåt genom båda gamla maskorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕线，把一个新线圈从两个旧线圈中往后拉出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繞線，把一個新線圈從兩個舊線圈中往後拉出。"
          }
        }
      }
    },
    "stitchDictionary.p2tog.accessibility.2": {
