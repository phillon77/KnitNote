    "calculator.share.rowInterval.input.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@ across %3$lld rows to adjust %4$lld stitches."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@），分布在 %3$lld 排中，共調整 %4$lld 針。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@），分布在 %3$lld 行内，共调整 %4$lld 针。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ auf %2$@ über %3$lld Reihen, um %4$lld Maschen anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ pendant %3$lld rangs pour ajuster %4$lld mailles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を%2$@で%3$lld段にわたり行い、%4$lld目を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@를 %2$@에서 %3$lld단에 걸쳐 적용해 %4$lld코를 조정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aan %2$@ over %3$lld toeren om %4$lld steken aan te passen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ på %2$@ over %3$lld rader for å justere %4$lld masker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ på %2$@ över %3$lld varv för att justera %4$lld maskor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$lld kerroksen aikana, jotta %4$lld silmukkaa säädetään."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ i %2$@ over %3$lld rækker for at justere %4$lld masker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ σε %2$@ για %3$lld σειρές, ώστε να προσαρμοστούν %4$lld πόντοι."
          }
        }
      }
    },
    "calculator.share.rowInterval.result.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld adjustment events. Stitches per event: %2$lld. Interval: %3$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %1$lld 次調整。每次調整針數：%2$lld。間隔：%3$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %1$lld 次调整。每次调整针数：%2$lld。间隔：%3$@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Anpassungsvorgänge. Maschen pro Vorgang: %2$lld. Abstand: %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld opérations d’ajustement. Mailles par opération : %2$lld. Intervalle : %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整は%1$lld回。1回あたりの目数：%2$lld。間隔：%3$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조정 %1$lld회. 회당 코 수: %2$lld. 간격: %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld aanpassingen. Steken per aanpassing: %2$lld. Tussenruimte: %3$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld justeringer. Masker per justering: %2$lld. Intervall: %3$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld justeringar. Maskor per justering: %2$lld. Intervall: %3$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld säätökertaa. Silmukoita säätökertaa kohti: %2$lld. Väli: %3$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld justeringer. Masker pr. justering: %2$lld. Mellemrum: %3$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ενέργειες προσαρμογής. Πόντοι ανά ενέργεια: %2$lld. Διάστημα: %3$@."
          }
        }
      }
    },
