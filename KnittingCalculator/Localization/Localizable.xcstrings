    "stitchDictionary.yarn-over.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold løkken på højre pind, når næste maske strikkes; næste maske er ikke en del af omslaget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Stricken der nächsten Masche die Schlinge rechts behalten. Die nächste Masche gehört nicht zum Umschlag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τη θηλιά δεξιά όταν πλέκετε τον επόμενο πόντο· ο επόμενος πόντος δεν ανήκει στο ζετέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep that loop on the right needle when knitting the next stitch; the next stitch is separate."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä lenkki oikealla puikolla seuraavaa silmukkaa neuloessasi; seuraava silmukka ei kuulu langankiertoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver cette boucle à droite en tricotant la maille suivante, qui ne fait pas partie du jeté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の目を編むときもループを右針に残します。次の目はかけ目に含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 코를 뜰 때 고리를 오른바늘에 남깁니다. 다음 코는 바늘비우기에 포함하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold løkken på høyre pinne når neste maske strikkes; neste maske er ikke en del av kastet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd die lus rechts wanneer je de volgende steek breit; die volgende steek hoort niet bij de omslag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll öglan på höger sticka när nästa maska stickas; nästa maska ingår inte i omslaget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编织下一针时保留挂针线圈；下一针不属于挂针操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編織下一針時保留掛針線圈；下一針不屬於掛針操作。"
          }
        }
      }
    },
    "stitchDictionary.yarn-over.accessibility.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
