    "stitchDictionary.purl.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En grundmaske med en vandret knop på den synlige side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Grundmasche mit einem Querknötchen auf der zugewandten Seite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βασικός πόντος με οριζόντιο εξόγκωμα στην όψη που βλέπετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A basic stitch with a bump on the purl side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perussilmukka, joka muodostaa poikittaisen nystyn näkyvälle puolelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une maille de base formant une bosse horizontale du côté visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手前側に横向きのふくらみができる基本の編み方です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 면에 가로 돌기가 생기는 기본 뜨기입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En grunnmaske med en vannrett kul på siden du ser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een basissteek met een horizontaal bobbeltje aan de zichtbare kant."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En grundmaska med en vågrät knopp på den synliga sidan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织出朝向自己一面有横向凸点的基本针法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織出朝向自己一面有橫向凸點的基本針法。"
          }
        }
      }
    },
    "stitchDictionary.purl.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold garnet foran. Stik højre pind fra højre mod venstre ind i første maske, ind mod dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Faden vor die Arbeit legen. Die rechte Nadel von rechts nach links, zum Körper hin, in die erste Masche stechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το νήμα μπροστά. Βάλτε τη δεξιά βελόνα στον πρώτο πόντο από δεξιά προς τα αριστερά, προς το μέρος σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep yarn in front. Insert the right needle into the first loop from right to left, toward you."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä lanka edessä. Työnnä oikea puikko ensimmäiseen silmukkaan oikealta vasemmalle, itseäsi kohti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer le fil devant. Piquer l’aiguille droite de droite à gauche dans la première maille, vers soi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を手前に置き、右針を最初の目に右から左へ、手前に向けて入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 앞에 두고 오른바늘을 첫 코에 오른쪽에서 왼쪽으로, 몸 쪽을 향해 넣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold garnet foran. Stikk høyre pinne fra høyre mot venstre inn i første maske, mot deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd het garen voor. Steek de rechternaald van rechts naar links, naar je toe, in de eerste lus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll garnet framför. Stick höger sticka från höger till vänster genom första maskan, mot dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作线置于前方，右针由右往左、朝自己插入第一个线圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作線置於前方，右針由右往左、朝自己插入第一個線圈。"
          }
        }
      }
    },
    "stitchDictionary.purl.accessibility.1": {
