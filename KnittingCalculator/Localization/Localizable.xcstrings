        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Neulo nostetun lenkin etureunasta oikein, jolloin lenkki kiertyy ja reikä sulkeutuu."
          }
        },
        "fr": {
          "stringUnit": {
