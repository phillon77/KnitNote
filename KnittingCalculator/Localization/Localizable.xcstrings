    "stitchDictionary.knit-front-back.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stik højre pind ind i samme maskes bagerste lænke, og strik ret igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In das hintere Glied derselben Masche einstechen und nochmals rechts stricken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλτε τη δεξιά βελόνα στο πίσω σκέλος του ίδιου πόντου και πλέξτε ξανά καλή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert the right needle into the back of that same loop and knit it again."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työnnä oikea puikko saman silmukan takareunaan ja neulo uudelleen oikein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piquer dans le brin arrière de la même maille et le tricoter à l’endroit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ目の向こう側に右針を入れ、もう一度表編みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 코의 뒤쪽에 오른바늘을 넣어 다시 겉뜨기합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stikk høyre pinne inn i bakre ledd av samme maske og strikk rett igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steek in de achterste lus van dezelfde steek en brei die opnieuw recht."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick in höger sticka i bakre bågen av samma maska och sticka rätt igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右针插入同一旧线圈的后半针，再织一下针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右針插入同一舊線圈的後半針，再織一下針。"
          }
        }
      }
    },
    "stitchDictionary.knit-front-back.accessibility.2": {
