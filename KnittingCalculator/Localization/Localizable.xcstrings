        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 기호를 싣지 않았습니다. 단계와 도안의 기호 설명을 참고하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bekreftet symbolvariant er tatt med. Se trinnene og mønsterets tegnforklaring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen geverifieerd symbool opgenomen. Lees de stappen en de legenda van je patroon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen verifierad symbolvariant ingår. Läs stegen och mönstrets teckenförklaring."
