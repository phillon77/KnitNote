    "stitchDictionary.cable-left-two.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bagved. Strik næste maske på venstre pind ret; behold den hvilende maske foran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden hinten. Die nächste Masche der linken Nadel rechts stricken; die wartende Masche bleibt vorn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα πίσω. Πλέξτε καλή τον επόμενο πόντο της αριστερής βελόνας· κρατήστε τον πόντο σε αναμονή μπροστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With yarn behind, knit the next stitch from the left needle; keep the held stitch in front."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka takana. Neulo vasemman puikon seuraava silmukka oikein; pidä odottava silmukka edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil derrière, tricoter la maille suivante de l’aiguille gauche à l’endroit ; garder la maille en attente devant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、左針の次の目を表編みします。休めた目は手前に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 왼바늘의 다음 코를 겉뜨기합니다. 보류한 코는 앞에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bak. Strikk neste maske på venstre pinne rett; behold den hvilende masken foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen achter. Brei de volgende steek van de linkernaald recht; houd de wachtende steek voor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bakom. Sticka nästa maska från vänster sticka rätt; håll den väntande maskan framför."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于后方，织左针的下一针；麻花针保持在前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於後方，織左針的下一針；麻花針保持在前方。"
          }
        }
      }
    },
    "stitchDictionary.cable-left-two.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet bagved. Strik næste maske på venstre pind ret; behold den hvilende maske foran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnung: Faden hinten. Die nächste Masche der linken Nadel rechts stricken; die wartende Masche bleibt vorn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχήμα: Νήμα πίσω. Πλέξτε καλή τον επόμενο πόντο της αριστερής βελόνας· κρατήστε τον πόντο σε αναμονή μπροστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing: With yarn behind, knit the next stitch from the left needle; keep the held stitch in front."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva: Lanka takana. Neulo vasemman puikon seuraava silmukka oikein; pidä odottava silmukka edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin : Fil derrière, tricoter la maille suivante de l’aiguille gauche à l’endroit ; garder la maille en attente devant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：糸を向こう側に置き、左針の次の目を表編みします。休めた目は手前に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 실을 뒤에 두고 왼바늘의 다음 코를 겉뜨기합니다. 보류한 코는 앞에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Garnet bak. Strikk neste maske på venstre pinne rett; behold den hvilende masken foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekening: Garen achter. Brei de volgende steek van de linkernaald recht; houd de wachtende steek voor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild: Garnet bakom. Sticka nästa maska från vänster sticka rätt; håll den väntande maskan framför."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图示：线置于后方，织左针的下一针；麻花针保持在前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示：線置於後方，織左針的下一針；麻花針保持在前方。"
          }
        }
      }
    },
    "stitchDictionary.cable-left-two.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik masken fra hjælpepinden ret. Begge masker er strikket, og rækkefølgen er krydset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Masche von der Zopfnadel rechts stricken. Beide Maschen sind gestrickt und ihre Reihenfolge ist gekreuzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξτε καλή τον πόντο της βοηθητικής βελόνας. Και οι δύο είναι πλεγμένοι και η σειρά τους έχει διασταυρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knit the held stitch from the cable needle. Both stitches are worked; their order is crossed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo apupuikon silmukka oikein. Molemmat on neulottu ja niiden järjestys on ristitty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter la maille de l’aiguille auxiliaire à l’endroit. Les deux mailles sont tricotées et leur ordre est croisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なわ編み針の目を表編みします。2目とも編み終わり、順序が交差します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꽈배기바늘의 코를 겉뜨기합니다. 두 코 모두 떠졌고 순서가 교차됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk masken fra hjelpepinnen rett. Begge maskene er strikket og rekkefølgen er krysset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei de steek van de kabelnaald recht. Beide steken zijn gebreid en hun volgorde is gekruist."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka maskan från hjälpstickan rätt. Båda är stickade och ordningen är korsad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织麻花针上的下针；两针都已织过，次序交叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織麻花針上的下針；兩針都已織過，次序交叉。"
          }
        }
      }
    },
