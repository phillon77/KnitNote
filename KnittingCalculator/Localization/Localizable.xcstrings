    "calculator.gauge.patternCaution": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the final count for pattern repeats and edge stitches."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最終針數仍需依花樣倍數與邊針調整。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请根据花样重复和边针调整最终针数。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die endgültige Anzahl an Musterrapporte und Randmaschen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptez le nombre final aux répétitions du motif et aux mailles lisières."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "模様の繰り返しと端目に合わせて最終目数を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무늬 반복과 가장자리 코에 맞게 최종 코 수를 조정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas het uiteindelijke aantal aan voor patroonherhalingen en kantsteken."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpass det endelige antallet til mønsterrapporter og kantmasker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa det slutliga antalet efter mönsterrapporter och kantmaskor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovita lopullinen määrä mallikertoihin ja reunasilmukoihin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpas det endelige antal til mønstergentagelser og kantmasker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόστε τον τελικό αριθμό στις επαναλήψεις του σχεδίου και στους ακριανούς πόντους."
          }
        }
      }
