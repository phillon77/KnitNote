    "calculator.adjustment.rows.failure.symmetricRequiresEvenStitches": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both-sides adjustment requires an even stitch count."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙側調整需要偶數針數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两侧调整要求针数为偶数。"
          }
        },
