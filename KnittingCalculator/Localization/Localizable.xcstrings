    "stitchDictionary.yarn-over.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en åben løkke mellem masker, så der dannes et hul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Maschen eine offene Schlinge für ein Loch hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια ανοιχτή θηλιά ανάμεσα σε πόντους, σχηματίζοντας τρύπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an open loop between stitches, leaving an eyelet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää avoin lenkki silmukoiden väliin, jolloin syntyy reikä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une boucle ouverte entre les mailles pour former un jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目と目の間にループを増やし、透かし穴を作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코 사이에 고리를 하나 늘려 구멍을 만듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en åpen løkke mellom masker, slik at det dannes et hull."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een open lus tussen steken toevoegen voor een gaatje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en öppen ögla mellan maskor för att bilda ett hål."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在针目之间增加一个线圈，形成孔洞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在針目之間增加一個線圈，形成孔洞。"
          }
        }
      }
    },
    "stitchDictionary.yarn-over.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempel mellem to retmasker: Før garnet frem mellem pindspidserne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel zwischen zwei rechten Maschen: Den Faden zwischen den Nadelspitzen nach vorn holen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παράδειγμα ανάμεσα σε δύο καλούς πόντους: φέρτε το νήμα μπροστά ανάμεσα στις άκρες των βελονών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between two knit stitches, bring yarn forward between the needle tips."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimerkki kahden oikean silmukan välissä: tuo lanka eteen puikkojen kärkien välistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple entre deux mailles endroit : amener le fil devant entre les pointes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表目と表目の間の例です。まず両針の間から糸を手前へ出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겉뜨기 두 코 사이의 예입니다. 먼저 두 바늘 끝 사이로 실을 앞으로 가져옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempel mellom to rettmasker: Før garnet frem mellom pinnespissene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld tussen twee rechte steken: breng het garen tussen de naaldpunten naar voren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exempel mellan två räta maskor: För garnet framåt mellan stickspetsarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本例位于两个下针之间，先将线从两针尖之间移到前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本例位於兩個下針之間，先將線從兩針尖之間移到前方。"
          }
        }
      }
    },
    "stitchDictionary.yarn-over.accessibility.1": {
