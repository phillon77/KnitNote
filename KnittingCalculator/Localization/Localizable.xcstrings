    "stitchDictionary.ssk.step.3": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip begge gamle masker. Dette er klassisk SSK med begge masker taget ret løs af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide alten Maschen abgleiten lassen. Dies ist das klassische SSK mit zweimaligem Abheben wie zum Rechtsstricken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τους δύο παλιούς πόντους. Αυτό είναι το κλασικό SSK, με δύο περάσματα σαν καλή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release both old loops. One new stitch remains; this is the classic two-knitwise SSK."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota molemmat vanhat silmukat. Tämä on perinteinen SSK, jossa molemmat nostetaan oikein neulomatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérer les deux anciennes mailles. C’est le SSK classique, avec deux glissements comme à l’endroit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の2目を外します。表目の向きに2回すべらせる基本の SSK です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 두 코를 빼면 새 코 하나가 남습니다. 두 번 모두 겉뜨기 방향으로 옮기는 기본 SSK 입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp begge gamle masker. Dette er klassisk SSK, der begge tas løs av som rett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat beide oude lussen los. Dit is de klassieke SSK waarbij beide steken recht worden afgehaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp båda gamla maskorna. Detta är klassisk SSK där båda lyfts som räta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放开两个旧线圈，留下一个新针目；本例为两次下针方向滑针的传统 SSK。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開兩個舊線圈，留下一個新針目；本例為兩次下針方向滑針的傳統 SSK。"
          }
        }
      }
    },
