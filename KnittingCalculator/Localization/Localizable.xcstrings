    "stitchDictionary.ssk.title": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs af, løs af, ret sammen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abheben, abheben, rechts zusammenstricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άπλεκτος, άπλεκτος, καλή μαζί"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip, slip, knit"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta, nosta, neulo yhteen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser, glisser, tricoter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSK：2目をすべらせて併せる（説明訳）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코줄임 (SSK)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs av, løs av, rett sammen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhalen, afhalen, samenbreien"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft, lyft, sticka ihop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑、滑、下针并针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑、滑、下針併針"
          }
        }
      }
    },
    "stitchDictionary.ssk.summary": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstrehældende indtagning med to masker, der drejes hver for sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links geneigte Abnahme mit zwei einzeln neu ausgerichteten Maschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείωση με κλίση αριστερά και χωριστή αλλαγή προσανατολισμού δύο πόντων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A left-leaning decrease using two separately reoriented stitches."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasemmalle kallistuva kavennus kahdella erikseen käännetyllä silmukalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminution inclinée à gauche après réorientation séparée de deux mailles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2目の向きを別々に変えてから編む、左傾斜の減目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 코의 방향을 각각 바꾼 뒤 모아 떠 왼쪽으로 줄입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstrevendt felling med to masker som snus hver for seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkshellende mindering met twee afzonderlijk gedraaide steken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänsterlutande minskning med två maskor som vrids var för sig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分别改变两针朝向后并针，形成左倾减针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分別改變兩針朝向後併針，形成左傾減針。"
          }
        }
      }
    },
    "stitchDictionary.ssk.step.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bagved. Tag to masker ret løs af, én ad gangen, på højre pind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faden hinten. Zwei Maschen nacheinander wie zum Rechtsstricken auf die rechte Nadel abheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήμα πίσω. Περάστε δύο πόντους άπλεκτους σαν καλή, έναν κάθε φορά, στη δεξιά βελόνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With yarn behind, slip two stitches knitwise, one at a time, to the right needle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanka takana. Nosta kaksi silmukkaa oikein neulomatta, yksi kerrallaan, oikealle puikolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil derrière, glisser deux mailles une par une comme à l’endroit sur l’aiguille droite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸を向こう側に置き、2目を1目ずつ表目の向きに右針へすべらせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 뒤에 두고 두 코를 한 코씩 겉뜨기 방향으로 오른바늘에 옮깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bak. Ta to masker løs av som rett, én om gangen, på høyre pinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garen achter. Haal twee steken één voor één recht af op de rechternaald."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Garnet bakom. Lyft två maskor som räta, en i taget, till höger sticka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线置于后方，以下针方向一次一针，将两针滑到右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線置於後方，以下針方向一次一針，將兩針滑到右針。"
          }
        }
      }
    },
    "stitchDictionary.ssk.accessibility.1": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
