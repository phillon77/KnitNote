    "stitchDictionary.video.external": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens an external teaching page. Internet is required."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟外部教學頁面，觀看影片需要網路。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开外部教学页面，观看视频需要联网。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部の解説ページを開きます。動画の視聴にはインターネット接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 강좌 페이지가 열립니다. 동영상을 보려면 인터넷 연결이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine externe Anleitungsseite. Internetverbindung erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une page de tutoriel externe. Une connexion Internet est nécessaire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een externe lespagina. Internetverbinding vereist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner en ekstern veiledningsside. Krever internett."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar en extern instruktionssida. Internetanslutning krävs."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ulkoisen ohjesivun. Internet-yhteys vaaditaan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner en ekstern vejledningsside. Kræver internet."
          }
        },
