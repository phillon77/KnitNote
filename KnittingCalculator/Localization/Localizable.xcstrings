          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 다음 코를 겉뜨기합니다. 걸러둔 코는 오른바늘에 그대로 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
