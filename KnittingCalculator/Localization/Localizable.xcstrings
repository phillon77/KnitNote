    "stitchDictionary.slip-knitwise.step.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt masken fra venstre til højre pind uden at slå garnet om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Masche ohne Umschlag von der linken auf die rechte Nadel schieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρετε τον πόντο από την αριστερή στη δεξιά βελόνα χωρίς να τυλίξετε νήμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the loop from the left needle onto the right without wrapping yarn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä silmukka vasemmalta oikealle puikolle kiertämättä lankaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférer la maille de gauche à droite sans enrouler le fil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸をかけず、目を左針から右針へ移します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 감지 않고 코를 왼바늘에서 오른바늘로 옮깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt masken fra venstre til høyre pinne uten å legge garnet rundt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuif de lus van de linker- naar de rechternaald zonder het garen om te slaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta maskan från vänster till höger sticka utan att lägga garnet runt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不绕线，将线圈由左针移到右针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不繞線，將線圈由左針移到右針。"
          }
        }
      }
    },
    "stitchDictionary.slip-knitwise.accessibility.2": {
      "comment": "Offline stitch dictionary. Authored translation; international knitting abbreviations are retained.",
      "localizations": {
        "da": {
          "stringUnit": {
