          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図：すくったループの手前側を表編みし、ねじって穴を閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림: 들어 올린 고리의 앞쪽을 겉뜨기해 실이 꼬여 구멍이 닫히게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegning: Strikk rett i fremre ledd av den løftede løkken, slik at den vris og hullet lukkes."
