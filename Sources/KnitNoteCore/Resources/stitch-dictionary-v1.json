{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "cyc-abbreviations",
      "title": "Knitting Abbreviations Master List — Craft Yarn Council",
      "url": "https://www.craftyarncouncil.com/standards/knitting-abbreviations",
      "checkedOn": "2026-09-15",
      "scope": "US operation definitions: k/p, sl1k/sl1p, kfb, k2tog/p2tog, classic SSK, SKP and S2KP2. Distinct operation sequences and their stitch arithmetic; not proof of Japanese or Korean glyphs."
    },
    {
      "id": "cyc-knit",
      "title": "Learn Knit Stitch (Garter Stitch) — Craft Yarn Council",
      "url": "https://craftyarncouncil.com/instructions_kn.php3",
      "checkedOn": "2026-09-15",
      "scope": "First Knit Row: right-hand yarn, insert front to back, wrap under and over, pull through, slip old loop."
    },
    {
      "id": "nihon-vogue-symbols",
      "title": "編み目記号の編み方 — 日本ヴォーグ社",
      "url": "https://www.tezukuritown.com/nv/c/ckihonkb5/",
      "checkedOn": "2026-09-15",
      "scope": "表目 name and illustrated sequence; vertical-stroke glyph for knit as shown on the right side. Controller visually checked original illustrations."
    },
    {
      "id": "banul-basic",
      "title": "(온라인) 대바늘 무료 기초 강의 — 바늘아카데미",
      "url": "https://banulacademy.com/product/free_basic_course/",
      "checkedOn": "2026-09-15",
      "scope": "Original Korean teaching provider's curriculum explicitly names lesson 2 겉뜨기. This source verifies terminology only, not glyph or needle-direction details."
    },
    {
      "id": "excelcraft-basics",
      "title": "棒針基礎教學 — 智廣實業／SO EASY手藝世界",
      "url": "https://www.excelcraft.com.tw/teaching/8e2997c2.php",
      "checkedOn": "2026-09-15",
      "scope": "Chinese teaching explicitly maps 表目 to 下針. 下针 is its simplified-character conversion."
    },
    {
      "id": "cyc-symbols",
      "title": "Knit Chart Symbols — Craft Yarn Council",
      "url": "https://www.craftyarncouncil.com/standards/knit-chart-symbols",
      "checkedOn": "2026-09-15",
      "scope": "Original table and linked glyph images visually checked. First drawn variants selected for purl, YO, kfb, M1L/R, k2tog, SSK, p2tog, purlwise slip, S2KP2 and version-1 1/1 cables. Source-specific RS/WS conditions. No separate SKP or knitwise-slip glyph asserted."
    },
    {
      "id": "banul-book",
      "title": "김대리의 데일리 뜨개 — 바늘이야기",
      "url": "https://en.banul.co.kr/Mobile/Product/Detail/detail/pid/1221",
      "checkedOn": "2026-09-15",
      "scope": "Original book listing and Korean contents confirm 겉뜨기, 안뜨기, 바늘비우기, KFB, M1L, M1R, K2TOG and SSK labels. Terminology only, not step or glyph evidence. Remaining Korean names explicitly marked explanatory translations."
    },
    {
      "id": "purlsoho-m1",
      "title": "Lightweight Raglan Pullover — Purl Soho",
      "url": "https://www.purlsoho.com/create/2022/01/18/lightweight-raglan-pullover-in-new-colors/",
      "checkedOn": "2026-09-15",
      "scope": "Special Instructions: M1L lifts bar front-to-back and knits back leg; M1R lifts back-to-front and knits front leg. Each adds one stitch without consuming the next stitch. Only technique instructions used; garment instructions not reproduced."
    },
    {
      "id": "tincanknits-ssk",
      "title": "SSK and SSSK — Tin Can Knits",
      "url": "https://blog.tincanknits.com/2013/10/03/ssk/",
      "checkedOn": "2026-09-15",
      "scope": "Classic SSK: slip twice individually knitwise, insert left needle through fronts, knit together. Does not teach SKP; no Japanese/Korean alias claim."
    },
    {
      "id": "gosyo-purl",
      "title": "裏目 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-12",
      "checkedOn": "2026-09-15",
      "scope": "Yarn in front, draw loop away and release; one stitch remains. Japanese name and operation; no Gosyo glyph selected."
    },
    {
      "id": "gosyo-skp",
      "title": "右上2目一度 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-15",
      "checkedOn": "2026-09-15",
      "scope": "Slip one, knit next, pass slipped stitch over: two become one. Combined with CYC explicit knitwise slip. This page is not evidence for SSK."
    },
    {
      "id": "gosyo-k2tog",
      "title": "左上2目一度 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-16",
      "checkedOn": "2026-09-15",
      "scope": "Work two loops together knitwise; two become one. Japanese name and operation."
    },
    {
      "id": "gosyo-cdd",
      "title": "中上3目一度 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-17",
      "checkedOn": "2026-09-15",
      "scope": "Slip two together, knit next and pass both over; center stitch on top, three become one. CYC establishes explicit as-if-k2tog insertion."
    },
    {
      "id": "gosyo-yo",
      "title": "かけ目 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-20",
      "checkedOn": "2026-09-15",
      "scope": "Knit-to-knit yarn-over: bring yarn forward, lay over right needle, then knit next separately."
    },
    {
      "id": "gosyo-lc",
      "title": "右上1目交差 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-22",
      "checkedOn": "2026-09-15",
      "scope": "First stitch held in front; knit next then held stitch. Exact 1/1 LC operation despite Japanese right-on-top naming."
    },
    {
      "id": "gosyo-rc",
      "title": "左上1目交差 — ごしょう産業",
      "url": "https://www.gosyo.co.jp/kiso-movie-bou/5-23",
      "checkedOn": "2026-09-15",
      "scope": "First stitch held behind; knit next then held stitch. Exact 1/1 RC operation despite Japanese left-on-top naming."
    },
    {
      "id": "knitter-academy-legend",
      "title": "손뜨개 마스터 과정 5강 — 박형아는 뜨개쟁이 아카데미",
      "url": "https://www.knitteracademy.kr/wp-content/uploads/2025/07/%EC%86%90%EB%9C%A8%EA%B0%9C%EB%A7%88%EC%8A%A4%ED%84%B0-5%EA%B0%95-%EC%95%84%EB%9E%80%EB%AC%B4%EB%8A%AC-%ED%9B%84%EB%93%9C%EC%A1%B0%EB%81%BC-%EA%B5%90%EC%9E%AC.pdf",
      "checkedOn": "2026-09-15",
      "scope": "PDF page 4 (printed 2) legend personally visually inspected: vertical stroke = 겉뜨기, horizontal stroke OR blank cell = 안뜨기 in this source. Only vertical/horizontal variants independently redrawn. No inferred universal RS/WS rule and no Korean cable-operation mapping. Original PDF/images remain research-only."
    }
  ],
